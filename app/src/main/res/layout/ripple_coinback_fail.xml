<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_rip_coinback_fail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:visibility="gone">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/fs_130">

        <com.teecoin.utils.RippleBackground
            android:id="@+id/rip_coinback_fail"
            android:layout_width="@dimen/fs_130"
            android:layout_height="@dimen/fs_130"
            android:layout_centerInParent="true"
            android:gravity="center"
            app:rb_color="#d50922"
            app:rb_duration="10000"
            app:rb_radius="32dp"
            app:rb_rippleAmount="3"
            app:rb_scale="2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/frg_transaction_iv_succes"
                android:layout_width="@dimen/fs_100"
                android:layout_height="@dimen/fs_100"
                android:layout_gravity="center"
                android:src="@drawable/ic_coinback_fail" />
        </LinearLayout>
    </RelativeLayout>

    <TextView
        style="@style/TCTextViewBlackBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="@dimen/fs_5"
        android:text="@string/text_fail"
        android:textAllCaps="true"
        android:textSize="@dimen/ts_20" />

    <TextView
        style="@style/TCTextViewBlack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/fs_2"
        android:layout_marginStart="@dimen/fs_2"
        android:visibility="gone"
        android:gravity="center_horizontal"/>
</LinearLayout>
