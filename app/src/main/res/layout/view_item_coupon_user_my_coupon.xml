<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/c_f2f2f2">

    <RelativeLayout
        android:id="@+id/view_item_coupon_user_my_coupon_rl_name"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fs_38"
        android:layout_marginStart="@dimen/fs_5">

        <RelativeLayout
            android:id="@+id/view_item_coupon_user_my_coupon_ll_status"
            android:layout_width="@dimen/fs_75"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/fs_10"
                android:background="@android:color/white" />

            <TextView
                android:id="@+id/view_item_coupon_user_my_coupon_tv_status"
                style="@style/TCTextViewWhite"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fs_25"
                android:background="@drawable/ic_coupon_expired"
                android:layout_marginTop="@dimen/fs_10"
                android:gravity="center_horizontal"
                android:text="@string/coupon_expired"
                android:textSize="@dimen/ts_11"
                android:paddingTop="@dimen/fs_1"
                android:visibility="visible" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/view_item_coupon_user_my_coupon_rl_tv_name"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toEndOf="@+id/view_item_coupon_user_my_coupon_ll_status">

            <TextView
                android:id="@+id/view_item_coupon_user_my_coupon_tv_name"
                style="@style/TCTextViewGoldBold"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/fs_15"
                android:background="@android:color/white"
                android:gravity="center"
                android:ellipsize="end"
                android:maxLines="2"
                android:paddingStart="@dimen/fs_10"
                android:text="@string/text_text"
                android:textSize="@dimen/ts_14" />

        </RelativeLayout>

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/view_item_coupon_user_my_coupon_rl_name"
        android:layout_marginStart="@dimen/fs_15"
        android:layout_marginEnd="@dimen/fs_15"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/fs_75"
            android:layout_marginTop="@dimen/fs_1_5"
            android:background="@android:color/white"
            android:orientation="horizontal"
            android:paddingStart="@dimen/fs_10"
            tools:ignore="RtlSymmetry">

            <ImageView
                android:id="@+id/item_coupon_user_my_coupon_iv_picture"
                android:layout_width="@dimen/fs_130"
                android:layout_height="match_parent"
                android:contentDescription="@string/todo"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_cover_chattee" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/fs_8"
                android:layout_marginStart="@dimen/fs_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/item_coupon_user_my_coupon_tv_name_vendor"
                        style="@style/TCTextViewBlackBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="" />

                    <me.zhanghai.android.materialratingbar.MaterialRatingBar
                        android:id="@+id/item_coupon_user_my_coupon_rb_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/fs_18"
                        android:layout_marginTop="@dimen/fs_2"
                        android:isIndicator="true"
                        android:numStars="5" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

        <include layout="@layout/view_user_coupon_my_coupon_time_start_end" />

        <TextView
            android:id="@+id/item_coupon_user_my_coupon_tv_hash_tags"
            style="@style/TCTextViewBlackLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_1_5"
            android:background="@android:color/white"
            android:gravity="center_vertical"
            android:padding="@dimen/fs_10"
            android:text="" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/fs_15" />
    </LinearLayout>

</RelativeLayout>
