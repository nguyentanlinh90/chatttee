<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/fs_108">

    <View
        android:id="@+id/item_vendor_v_indicator_select"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fs_5"
        android:background="@color/c_b2973f"
        android:visibility="invisible" />

    <ImageView
        android:id="@+id/item_vendor_iv_image"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fs_103"
        android:layout_alignParentBottom="true"
        android:contentDescription="@string/todo"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_cover_chattee" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="@dimen/fs_108"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/fs_10"
        android:layout_marginTop="@dimen/fs_5"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/item_vendor_iv_write"
            android:layout_width="@dimen/fs_23"
            android:layout_height="@dimen/fs_23"
            android:contentDescription="@string/todo"
            android:src="@drawable/ic_pen_bg_circle_white" />

        <ImageView
            android:id="@+id/item_vendor_iv_share"
            android:layout_width="@dimen/fs_23"
            android:layout_height="@dimen/fs_23"
            android:layout_marginBottom="@dimen/fs_8"
            android:layout_marginTop="@dimen/fs_8"
            android:contentDescription="@string/todo"
            android:src="@drawable/ic_share_bg_circle_white" />

        <ImageView
            android:id="@+id/item_vendor_iv_favorite"
            android:layout_width="@dimen/fs_23"
            android:layout_height="@dimen/fs_23"
            android:background="@drawable/state_favorite"
            android:contentDescription="@string/todo" />
    </LinearLayout>

    <include layout="@layout/view_icon_direction"
        android:visibility="gone"
        />
</RelativeLayout>
