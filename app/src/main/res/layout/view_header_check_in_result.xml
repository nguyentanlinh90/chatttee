<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/view_header_check_in_result_iv_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/view_header_check_in_result_rl_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="1dp"
            android:layout_height="@dimen/fs_15" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/view_header_check_in_result_iv_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/todo"
                android:padding="@dimen/fs_15"
                android:src="@drawable/ic_back_white_black_shadow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="@dimen/fs_15"
                tools:ignore="RtlSymmetry">

                <TextView
                    android:id="@+id/view_header_check_in_result_tv_name_vendor"
                    style="@style/TCTextViewWhiteBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/text_three_dot"
                    android:textSize="@dimen/ts_18" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="@dimen/fs_15" />

                <LinearLayout
                    style="@style/LinearLayoutHorizontalFullWidth"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/view_header_check_in_result_tv_rating"
                        style="@style/TCTextViewWhite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_three_dot"
                        android:textSize="@dimen/ts_14" />

                    <me.zhanghai.android.materialratingbar.MaterialRatingBar
                        android:id="@+id/view_header_check_in_result_rating_bar"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/fs_13"
                        android:layout_marginStart="@dimen/fs_10"
                        android:layout_marginEnd="@dimen/fs_10"
                        android:isIndicator="true"
                        android:rating="0"
                        android:stepSize="0.5" />

                    <TextView
                        android:id="@+id/view_header_check_in_result_tv_review"
                        style="@style/TCTextViewWhite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_three_dot"
                        android:textSize="@dimen/ts_14" />

                    <ImageView
                        android:id="@+id/view_header_check_in_result_iv_is_coupon"
                        android:layout_width="@dimen/fs_30"
                        android:layout_height="@dimen/fs_25"
                        android:layout_marginStart="@dimen/fs_10"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/ic_coupon_category" />

                    <ImageView
                        android:id="@+id/view_header_check_in_result_iv_is_cash"
                        android:layout_width="@dimen/fs_40"
                        android:layout_height="@dimen/fs_20"
                        android:layout_marginStart="@dimen/fs_10"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/ic_cash_voucher"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="@dimen/fs_10" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="@dimen/fs_18"
            android:layout_marginBottom="@dimen/fs_10"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/view_header_check_in_result_iv_write_review"
                android:layout_width="@dimen/fs_30"
                android:layout_height="@dimen/fs_30"
                android:contentDescription="@string/todo"
                android:src="@drawable/ic_pen_bg_circle_white" />

            <ImageView
                android:id="@+id/view_header_check_in_result_iv_share"
                android:layout_width="@dimen/fs_30"
                android:layout_height="@dimen/fs_30"
                android:layout_marginStart="@dimen/fs_15"
                android:layout_marginEnd="@dimen/fs_15"
                android:contentDescription="@string/todo"
                android:src="@drawable/ic_share_bg_circle_white" />

            <ImageView
                android:id="@+id/view_header_check_in_result_iv_favorite"
                android:layout_width="@dimen/fs_30"
                android:layout_height="@dimen/fs_30"
                android:layout_gravity="center_vertical"
                android:background="@drawable/state_favorite"
                android:contentDescription="@string/todo" />

        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
