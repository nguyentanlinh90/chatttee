<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_f2f2f2"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/frg_history_detail_ll_root_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/view_header_history_detail" />


        <TextView
            android:id="@+id/frg_user_payment_coinback_detail_tv_address"
            style="@style/TCTextViewBlack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/fs_4"
            android:paddingBottom="@dimen/fs_8"
            android:paddingLeft="@dimen/fs_10"
            android:paddingRight="@dimen/fs_10"
            android:paddingTop="@dimen/fs_8" />

        <include layout="@layout/view_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/white"
            android:orientation="vertical"
            android:paddingBottom="@dimen/fs_25"
            android:paddingTop="@dimen/fs_10">

            <RelativeLayout
                android:id="@+id/frg_history_detail_rl_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="@dimen/fs_20"
                android:paddingRight="@dimen/fs_20">

                <TextView
                    style="@style/TCTextViewBlack1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_bill" />

                <TextView
                    android:id="@+id/frg_user_payment_coinback_detail_tv_total_bill"
                    style="@style/TCTextViewBlackBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/text_zero_tec"
                    android:textSize="@dimen/ts_13" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/frg_history_detail_rl_payment_coin_back"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fs_10"
                android:paddingLeft="@dimen/fs_20"
                android:paddingRight="@dimen/fs_20">

                <TextView
                    style="@style/TCTextViewBlack1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/amount_paid_by_wallet" />

                <TextView
                    android:id="@+id/frg_user_payment_coinback_detail_tv_amount_wallet"
                    style="@style/TCTextViewGoldBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/text_zero_tec"
                    android:textSize="@dimen/ts_13" />
            </RelativeLayout>

            <TextView
                android:id="@+id/frg_user_payment_coinback_detail_tv_converd"
                style="@style/TCTextViewBlackBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fs_10"
                android:gravity="right"
                android:paddingLeft="@dimen/fs_20"
                android:paddingRight="@dimen/fs_20"
                android:text="@string/text_zero_tec"
                android:textSize="@dimen/ts_13" />

            <LinearLayout
                style="@style/LinearLayoutHorizontalFullWidth"
                android:layout_marginTop="@dimen/fs_10"
                android:gravity="center_vertical"
                android:paddingBottom="@dimen/fs_10"
                android:paddingLeft="@dimen/fs_20"
                android:paddingRight="@dimen/fs_20">

                <TextView
                    style="@style/TCTextViewBlack1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:text="@string/text_fee"

                    />

                <TextView
                    android:id="@+id/frg_user_payment_coinback_detail_tv_fee"
                    style="@style/TCTextViewGoldBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right"
                    android:gravity="right"
                    android:text="@string/text_zero"
                    android:textSize="@dimen/ts_13"
                    tools:ignore="RtlHardcoded" />
            </LinearLayout>

            <include layout="@layout/view_line" />

            <RelativeLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/fs_10"
                android:layout_marginTop="@dimen/fs_10"
                android:paddingLeft="@dimen/fs_20"
                android:paddingRight="@dimen/fs_20">

                <TextView
                    style="@style/TCTextViewBlack1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/amount_paid_by_cash" />

                <TextView
                    android:id="@+id/frg_user_payment_coinback_detail_tv_amount_cash"
                    style="@style/TCTextViewBlackBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/text_zero_tec"
                    android:textSize="@dimen/ts_13" />
            </RelativeLayout>

            <include layout="@layout/view_line" />

            <LinearLayout
                android:id="@+id/frg_user_payment_coinback_detail_view_amount_coinback"
                style="@style/LinearLayoutVerticalFullWidth"

                android:orientation="vertical">

                <LinearLayout
                    style="@style/LinearLayoutHorizontalFullWidth"
                    android:layout_marginTop="@dimen/fs_10"
                    android:gravity="center_vertical"
                    android:paddingBottom="@dimen/fs_10"
                    android:paddingLeft="@dimen/fs_20"
                    android:paddingRight="@dimen/fs_20">

                    <TextView
                        style="@style/TCTextViewBlack1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:text="@string/general_amount"

                        />

                    <TextView
                        android:id="@+id/frg_user_payment_coinback_detail_tv_amount_coinback"
                        style="@style/TCTextViewGoldBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right"
                        android:gravity="right"
                        android:text="@string/text_zero"
                        android:textSize="@dimen/ts_13"
                        tools:ignore="RtlHardcoded" />
                </LinearLayout>

                <include layout="@layout/view_line" />
            </LinearLayout>

            <RelativeLayout
                android:id="@+id/frg_user_payment_coinback_detail_view_amount_payment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fs_15"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/fs_20"
                android:paddingRight="@dimen/fs_20"
                android:visibility="visible">

                <TextView
                    style="@style/TCTextViewBlackBoldLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="@string/payment_detail_amount"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/frg_user_payment_coinback_detail_tv_amount"
                    style="@style/TCTextViewGoldBoldLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/text_zero"
                    tools:ignore="RelativeOverlap" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/frg_user_payment_coinback_detail_view_coinback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fs_15"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/fs_20"
                android:paddingRight="@dimen/fs_20"
                android:visibility="visible">

                <TextView
                    style="@style/TCTextViewBlackBoldLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="@string/text_coin_back"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/frg_user_payment_coinback_detail_tv_coinback"
                    style="@style/TCTextViewGoldBoldLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/text_zero"
                    tools:ignore="RelativeOverlap" />

            </RelativeLayout>
        </LinearLayout>

    </LinearLayout>
</android.support.v4.widget.NestedScrollView>