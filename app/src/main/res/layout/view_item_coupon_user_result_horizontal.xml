<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/fs_270"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/fs_15"
    android:layout_marginEnd="@dimen/fs_13"
    android:background="@android:color/white"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/view_item_coupon_user_result_horizontal_rl_banner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fs_150">

        <ImageView
            android:id="@+id/view_item_coupon_user_result_horizontal_iv_banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@string/todo"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_cover_chattee" />

        <!--<include layout="@layout/view_number_gift" />-->

    </RelativeLayout>

    <include layout="@layout/view_item_coupon_user_info_item_catalogue" />

