<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_not_select_gender_rl_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="@dimen/fs_31"
        android:layout_marginEnd="@dimen/fs_31"
        android:background="@drawable/bg_white_solid_no_border_5_radius"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingTop="@dimen/fs_21"
        android:paddingBottom="@dimen/fs_21">

        <ImageView
            android:layout_width="@dimen/fs_70"
            android:layout_height="@dimen/fs_70"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/todo"
            android:src="@drawable/ic_fail" />

        <TextView
            style="@style/TCTextViewGoldBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/fs_10"
            android:layout_marginBottom="@dimen/fs_10"
            android:text="@string/gender_has_not_been_selected"
            android:textAllCaps="true"
            android:textColor="@color/c_a6a8b0"
            android:textSize="@dimen/ts_16" />

        <TextView
            style="@style/TCTextViewBlack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/fs_20"
            android:gravity="center_horizontal"
            android:lineSpacingExtra="@dimen/fs_5"
            android:text="@string/please_choose_gender"
            android:textSize="@dimen/ts_12" />

        <include
            layout="@layout/button_ok"
            android:layout_width="@dimen/fs_150"
            android:layout_height="@dimen/fs_39"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/fs_66" />

    </LinearLayout>
</RelativeLayout>
