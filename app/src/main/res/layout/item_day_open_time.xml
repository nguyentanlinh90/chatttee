<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_title"
            style="@style/TCTextViewBlack"
            android:layout_width="@dimen/fs_85"
            android:layout_height="wrap_content"
            android:background="@color/c_f2f2f2"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/fs_5"
            android:text="@string/text_text"
            android:textSize="@dimen/ts_12"
            android:padding="@dimen/fs_2"
            tools:ignore="RtlSymmetry" />

        <com.teecoin.ui.TCRecyclerView
            android:id="@+id/rcv_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/fs_5"
            android:layout_toEndOf="@+id/tv_title"
            android:orientation="horizontal"
            app:layoutManager="android.support.v7.widget.LinearLayoutManager"
            tools:listitem="@layout/item_times" />

        <TextView
            android:id="@+id/tv_close"
            style="@style/TCTextViewGold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fs_5"
            android:layout_toEndOf="@+id/tv_title"
            android:gravity="center_vertical"
            android:text="@string/text_closed"
            android:textColor="@color/c_d0021b"
            android:visibility="gone" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/fs_5" />

</LinearLayout>
