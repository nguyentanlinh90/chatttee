<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/id_tutorial_iv_image"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/fs_243"
        android:adjustViewBounds="true"
        android:contentDescription="@string/todo"
        android:layout_gravity="center"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_logo_chattee" />

    <TextView
        android:id="@+id/id_tutorial_tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginEnd="@dimen/fs_20"
        android:layout_marginTop="@dimen/fs_20"
        android:layout_marginStart="@dimen/fs_20"
        style="@style/TCTextViewGoldBold"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/fs_8"
        android:text="@string/text_text"
        android:textSize="@dimen/ts_16" />

    <TextView
        android:id="@+id/id_tutorial_tv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginEnd="@dimen/fs_15"
        android:layout_marginStart="@dimen/fs_15"
        android:layout_marginTop="@dimen/fs_10"
        android:ellipsize="end"
        style="@style/TCTextViewBlack"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/fs_8"
        android:maxLines="4"
        android:text="@string/text_text"
        android:textSize="@dimen/ts_12" />

