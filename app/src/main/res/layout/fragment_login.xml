<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/LinearLayoutVerticalParent"
    android:layout_gravity="center"
    android:background="@color/c_f2f2f2"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:paddingEnd="@dimen/fs_20"
    android:paddingStart="@dimen/fs_20">

    <include layout="@layout/view_button_signup_signin" />

    <TextView
        style="@style/TCTextViewBlack"
        android:layout_marginBottom="@dimen/fs_22"
        android:layout_marginTop="@dimen/fs_31"
        android:gravity="center"
        android:textSize="@dimen/ts_15"
        android:text="@string/sign_in_or" />

    <TextView
        android:id="@+id/fragment_login_tv_import_wallet"
        style="@style/TCTextViewGoldBoldMedium"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fs_40"
        android:layout_marginBottom="@dimen/fs_20"
        android:background="@drawable/bg_transparent_solid_gold_border_5_radius"
        android:gravity="center"
        android:text="@string/text_import_existing_wallet" />

</LinearLayout>
