<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/fs_56">

        <ImageView
            android:id="@+id/view_header_review_list_iv_back"
            android:layout_width="@dimen/fs_56"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back_black_24pt" />

        <TextView
            android:id="@+id/view_header_review_list_tv_review_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="REVIEWS"
            android:textAllCaps="true" />

        <LinearLayout
            android:layout_width="@dimen/fs_56"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center"
            android:visibility="visible">

            <ImageView
                android:layout_width="@dimen/fs_20"
                android:layout_height="@dimen/fs_22"
                android:background="@drawable/ic_review_list_active"
                android:contentDescription="@string/todo"
                android:visibility="gone" />

            <ImageView
                android:layout_width="@dimen/fs_20"
                android:layout_height="@dimen/fs_22"
                android:visibility="gone"
                android:background="@drawable/ic_review_thumb_active"
                android:contentDescription="@string/todo" />
        </LinearLayout>
    </RelativeLayout>

    <include layout="@layout/view_line" />
</LinearLayout>
