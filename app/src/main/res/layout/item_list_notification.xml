<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frag_notify_item_ll_parent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/c_ffffff"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/fs_10"
        android:layout_marginEnd="@dimen/fs_5"
        android:layout_marginStart="@dimen/fs_10"
        android:layout_marginTop="@dimen/fs_10"
        android:orientation="horizontal"
        tools:ignore="UselessParent">

        <ImageView
            android:id="@+id/frag_notify_item_iv_icon"
            android:layout_width="@dimen/fs_34"
            android:layout_height="@dimen/fs_30"
            android:layout_gravity="center_vertical"
            android:contentDescription="@string/todo"
            android:src="@drawable/ic_notification_gold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/fs_5"
            android:layout_marginStart="@dimen/fs_15"
            android:layout_marginTop="@dimen/fs_5">

            <TextView
                android:id="@+id/frag_notify_item_tv_title"
                style="@style/TCTextViewBlack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/fs_3"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/text_content"
                android:textSize="@dimen/ts_14" />

            <TextView
                android:id="@+id/frag_notify_item_tv_date"
                style="@style/TCTextViewBlack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/frag_notify_item_tv_title"
                android:layout_marginEnd="@dimen/fs_3"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/text_content"
                android:textSize="@dimen/ts_12" />

            <TextView
                android:id="@+id/frag_notify_item_tv_message"
                style="@style/TCTextViewGray"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/frag_notify_item_tv_date"
                android:text="@string/text_description"
                android:textSize="@dimen/ts_12" />

<!---->
        </RelativeLayout>
    </LinearLayout>

    <include layout="@layout/view_line" />

</LinearLayout>
