<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="right|center_vertical"
    tools:ignore="RtlHardcoded">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        tools:ignore="RtlSymmetry,UseCompoundDrawables">

        <ImageView
            android:id="@+id/view_item_coupon_user_catalogue_horizontal_list_header_iv_icon"
            android:layout_width="@dimen/fs_18"
            android:layout_height="@dimen/fs_20"
            android:layout_gravity="center_vertical"
            android:layout_marginRight="@dimen/fs_10"
            android:contentDescription="@string/todo"
            android:visibility="gone"
            android:src="@drawable/ic_gift_coin" />

        <TextView
            android:id="@+id/view_item_coupon_user_catalogue_horizontal_list_header_tv_name"
            style="@style/text_view_title_item_main_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/fs_10"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingBottom="0dp"
            android:text="@string/text_text"
            android:textSize="@dimen/ts_14" />
    </LinearLayout>

    <include
        layout="@layout/view_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
         />


</RelativeLayout>
