<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/LinearLayoutVerticalParent">

    <LinearLayout
        style="@style/LinearLayoutVerticalFullWidth"
        android:layout_centerInParent="true">

        <include layout="@layout/view_transaction_success" />

        <LinearLayout
            style="@style/view_group_discover"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/fs_20">

            <RelativeLayout style="@style/view_header_group_discover">

                <TextView
                    style="@style/TCTextViewBlack"
                    android:text="@string/converted_amount" />

                <TextView
                    android:id="@+id/frag_convert_to_tec_success_tv_convert_amount"
                    style="@style/TCTextViewBlackBoldMedium"
                    android:layout_alignParentEnd="true"
                    android:text="@string/text_zero" />

            </RelativeLayout>

            <RelativeLayout style="@style/view_header_group_discover"
                android:paddingBottom="@dimen/fs_5"
                >

                <TextView
                    style="@style/TCTextViewBlack"
                    android:text="@string/receivable" />

                <TextView
                    android:id="@+id/frag_convert_to_tec_success_tv_receivable"
                    style="@style/TCTextViewBlackBoldMedium"
                    android:layout_alignParentEnd="true"
                    android:text="@string/text_zero" />

            </RelativeLayout>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        style="@style/LinearLayoutVerticalFullWidth"
        android:layout_alignParentBottom="true"
        android:paddingBottom="@dimen/fs_25">

        <TextView
            android:id="@+id/frag_convert_to_tec_success_tv_new_convert"
            style="@style/TCTextViewWhite"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fs_39"
            android:layout_marginStart="@dimen/fs_50"
            android:layout_marginTop="@dimen/fs_20"
            android:layout_marginEnd="@dimen/fs_50"
            android:layout_marginBottom="@dimen/fs_25"
            android:background="@drawable/bg_gold_solid_no_border_30_radius"
            android:gravity="center"
            android:text="@string/new_convert_to_tec"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/frag_convert_to_tec_success_tv_back_to_wallet"
            style="@style/TCTextViewGold"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fs_39"
            android:layout_marginStart="@dimen/fs_50"
            android:layout_marginEnd="@dimen/fs_50"
            android:background="@drawable/bg_white_solid_gold_border_30_radius"
            android:gravity="center"
            android:text="@string/back_to_my_wallet"
            android:textAllCaps="false" />
    </LinearLayout>
</RelativeLayout>
