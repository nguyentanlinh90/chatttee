<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_f2f2f2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:focusableInTouchMode="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/c_f2f2f2"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="@dimen/fs_20"
            android:paddingBottom="@dimen/fs_20"
            android:paddingStart="@dimen/fs_10"
            android:paddingEnd="@dimen/fs_10"
            >


            <TextView
                style="@style/TCTextViewBlackBoldLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/referral_total_reward" />

            <TextView
                android:id="@+id/frg_referral_detail_tv_total_reward"
                style="@style/TCTextViewCoinNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fs_10"
                android:text="@string/text_zero" />

        </LinearLayout>

        <TextView
            android:id="@+id/frg_referral_event_tv_event_receive_date"
            style="@style/TCTextViewBlack1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/fs_30"
            android:layout_marginTop="@dimen/fs_20"
            android:gravity="center_vertical"
            android:text="@string/text_referral_code"
            android:textSize="@dimen/ts_16" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/fs_50"
            android:layout_marginEnd="@dimen/fs_20"
            android:layout_marginStart="@dimen/fs_30"
            android:layout_marginTop="@dimen/fs_10"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/frg_referral_detail_tv_referral_code"
                style="@style/TCTextViewGoldBoldLarge"
                android:layout_width="0dp"
                android:layout_weight="0.5"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_solid_gray_border_3_radius"
                android:paddingBottom="@dimen/fs_12"
                android:paddingTop="@dimen/fs_12"
                android:gravity="center"
                android:text="" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="0.3"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >
                <RelativeLayout
                    android:id="@+id/frg_referral_detail_rl_copy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fs_20"
                    android:background="@drawable/bg_oval_gold_solid_no_border"
                    android:padding="@dimen/fs_5">

                    <ImageView
                        style="@style/TCTextViewWhite"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_centerInParent="true"
                        android:src="@drawable/ic_copy"
                        android:contentDescription="@string/todo" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/frg_referral_detail_rl_share"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fs_20"
                    android:background="@drawable/bg_oval_gold_solid_no_border"
                    android:padding="@dimen/fs_5">

                    <ImageView
                        style="@style/TCTextViewWhite"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_centerInParent="true"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/ic_share_1" />
                </RelativeLayout>
            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            style="@style/view_group_discover"
            android:gravity="top"
            android:layout_marginTop="@dimen/fs_50"
            >
            <TextView
                style="@style/TCTextViewBlack1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/fs_7"
                android:layout_marginTop="@dimen/fs_15"
                android:text="@string/referral_history"
                android:textAllCaps="true"
                android:textSize="@dimen/ts_16" />
            <com.teecoin.ui.TCRecyclerView
                android:id="@+id/frg_referral_detail_rcv_referral_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fs_15"
                tools:listitem="@layout/item_referral_detail" />
        </LinearLayout>
    </LinearLayout>
</android.support.v4.widget.NestedScrollView>
