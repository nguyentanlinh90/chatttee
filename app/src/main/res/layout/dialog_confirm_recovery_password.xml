<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/fs_10"
        android:layout_marginRight="@dimen/fs_10"
        android:layout_marginTop="@dimen/fs_20"
        android:background="@drawable/bg_white_solid_no_border_5_radius"
        android:orientation="vertical"
        tools:ignore="UselessParent">

        <TextView
            style="@style/TCTextViewGoldBoldLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_10"
            android:gravity="center"
            android:text="@string/text_recovery_password" />

        <TextView
            style="@style/TCTextViewBlackMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/fs_20"
            android:layout_marginStart="@dimen/fs_10"
            android:layout_marginTop="@dimen/fs_20"
            android:gravity="center"
            android:text="@string/please_input_your_recovery_password_to_confirm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/fs_38"
            android:layout_marginTop="@dimen/fs_20"
            android:background="@drawable/bg_light_gray_solid_no_border_5_radius">

            <EditText
                android:id="@+id/dialog_confirm_password_et_pass"
                style="@style/TCEditText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLength="30"
                android:paddingStart="@dimen/fs_20"
                android:text=""
                tools:ignore="LabelFor,RtlSymmetry" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/fs_34"
            android:layout_marginBottom="@dimen/fs_30"
            android:layout_marginLeft="@dimen/fs_20"
            android:layout_marginRight="@dimen/fs_20"
            android:layout_marginTop="@dimen/fs_40"
            android:orientation="horizontal"
            android:weightSum="1">

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.45">

                <include layout="@layout/button_cancel" />
            </RelativeLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.1" />

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.45">

                <include layout="@layout/button_ok" />
            </RelativeLayout>
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
