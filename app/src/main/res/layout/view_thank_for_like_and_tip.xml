<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:paddingBottom="@dimen/fs_15">

    <TextView
        style="@style/TCTextViewGoldBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/fs_10"
        android:layout_marginTop="@dimen/fs_10"
        android:gravity="center"
        android:text="@string/dialog_tip_title" />

    <include layout="@layout/view_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingEnd="@dimen/fs_50"
        android:paddingStart="@dimen/fs_50">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_20"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_tip_thank_you" />

        </LinearLayout>

        <TextView
            style="@style/TCTextViewBlack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/you_have_liked_and_sent_a_tip_for_this_review" />

        <TextView
            style="@style/TCTextViewBlack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/do_you_want_to_tip_more" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_10"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/view_thank_for_like_and_tip_tv_cancel"
                style="@style/TCTextViewGray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_solid_gray_border_30_radius"
                android:paddingBottom="@dimen/fs_5"
                android:paddingLeft="@dimen/fs_25"
                android:paddingRight="@dimen/fs_25"
                android:paddingTop="@dimen/fs_5"
                android:text="@string/text_cancel" />

            <TextView
                android:id="@+id/view_thank_for_like_and_tip_tv_ok"
                style="@style/TCTextViewWhite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_10"
                android:background="@drawable/bg_gold_solid_no_border_30_radius"
                android:paddingBottom="@dimen/fs_5"
                android:paddingLeft="@dimen/fs_35"
                android:paddingRight="@dimen/fs_35"
                android:paddingTop="@dimen/fs_5"
                android:text="@string/text_ok" />
        </LinearLayout>
    </LinearLayout>


</LinearLayout>
