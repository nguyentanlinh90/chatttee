<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frag_coupon_user_result_view_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/fs_5"
    android:background="@android:color/white"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/frag_coupon_user_result_view_more"
        android:layout_width="@dimen/fs_150"
        android:layout_height="@dimen/fs_30"
        android:layout_marginBottom="@dimen/fs_20"
        android:layout_marginTop="@dimen/fs_20"
        android:background="@drawable/bg_promotion_title"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/TCTextViewWhiteBoldMedium"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/fs_5"
            android:gravity="center"
            android:text="@string/coupon_more_for_you"
            tools:ignore="RelativeOverlap" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/frag_coupon_user_result_view_check_in"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/fs_20"
        android:layout_marginStart="@dimen/fs_10"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:layout_width="@dimen/fs_20"
            android:layout_height="@dimen/fs_20"
            android:src="@drawable/ic_coupon_checkin"
            tools:ignore="ContentDescription" />

        <TextView
            style="@style/TCTextViewGold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fs_10"
            android:text="@string/coupon_check_in_to_get_tec" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/frag_coupon_user_result_view_coupon_running"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:paddingStart="@dimen/fs_15"
        android:visibility="gone"
        tools:ignore="RtlSymmetry">

        <include layout="@layout/view_header_list_coupon_user_result" />

        <com.teecoin.ui.TCRecyclerView
            android:id="@+id/item_coupon_user_catalogue_rcv_running"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:orientation="horizontal"
            app:layoutManager="android.support.v7.widget.LinearLayoutManager"
            tools:listitem="@layout/view_item_coupon_user_result_horizontal" />

    </LinearLayout>

    <include layout="@layout/view_line_10" />

    <LinearLayout
        android:id="@+id/frag_coupon_user_result_view_coupon_purchase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/fs_15"
        android:visibility="gone"
        tools:ignore="RtlSymmetry">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="@dimen/fs_10"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:layout_width="@dimen/fs_20"
                android:layout_height="@dimen/fs_22"
                android:layout_gravity="center_vertical"
                android:contentDescription="@string/todo"
                android:src="@drawable/ic_coupon_gold" />

            <TextView
                android:id="@+id/frag_user_coupon_catalogue_result_tv_name"
                style="@style/TCTextViewGoldBoldLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/fs_10"
                android:layout_marginStart="@dimen/fs_10"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/coupons_for_purchasing" />
        </LinearLayout>

        <com.teecoin.ui.TCRecyclerView
            android:id="@+id/item_coupon_user_catalogue_rcv_purchasing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:orientation="horizontal"
            app:layoutManager="android.support.v7.widget.LinearLayoutManager"
            tools:listitem="@layout/view_item_coupon_user_result_horizontal" />
    </LinearLayout>

    <include layout="@layout/view_line_10" />

    <LinearLayout
        android:id="@+id/frag_coupon_user_result_view_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fs_15"
        android:orientation="vertical"
        android:paddingBottom="@dimen/fs_10"
        android:paddingStart="@dimen/fs_15"
        android:visibility="gone"
        tools:ignore="RtlSymmetry">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/TCTextViewGoldBoldLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/fs_10"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingBottom="@dimen/fs_10"
                android:text="@string/menu" />
        </LinearLayout>

        <com.teecoin.ui.TCRecyclerView
            android:id="@+id/item_coupon_user_catalogue_rcv_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:orientation="horizontal"
            app:layoutManager="android.support.v7.widget.LinearLayoutManager"
            tools:listitem="@layout/view_item_coupon_user_result_menu_image" />
    </LinearLayout>

</LinearLayout>
