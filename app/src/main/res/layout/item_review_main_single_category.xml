<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/fs_3"
    android:layout_marginTop="@dimen/fs_7"
    android:layout_marginEnd="@dimen/fs_3"
    android:layout_marginBottom="@dimen/fs_7"
    android:background="@drawable/my_shadow_radius_4pt"
    android:elevation="@dimen/fs_2"
    android:orientation="vertical"
    android:paddingTop="@dimen/fs_10"
    android:paddingBottom="@dimen/fs_10"
    android:paddingStart="@dimen/fs_10"
    tools:ignore="RtlSymmetry">

    <RelativeLayout
        android:id="@+id/item_review_main_single_category_rl_logo"
        android:layout_width="@dimen/fs_210"
        android:layout_marginEnd="@dimen/fs_2"
        android:layout_height="@dimen/fs_90">

        <ImageView
            android:id="@+id/item_category_single_iv_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/fs_8"
            android:layout_marginStart="@dimen/fs_1"
            android:contentDescription="@string/todo"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_cover_chattee" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/fs_15"
            android:gravity="end|center_vertical"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/item_category_single_iv_write"
                android:layout_width="@dimen/fs_19"
                android:layout_height="@dimen/fs_19"
                android:contentDescription="@string/todo"
                android:src="@drawable/ic_pen_bg_circle_white" />

            <ImageView
                android:id="@+id/item_category_single_iv_share"
                android:layout_width="@dimen/fs_19"
                android:layout_height="@dimen/fs_19"
                android:layout_marginBottom="@dimen/fs_8"
                android:layout_marginTop="@dimen/fs_8"
                android:contentDescription="@string/todo"
                android:src="@drawable/ic_share_bg_circle_white" />

            <ImageView
                android:id="@+id/item_category_single_iv_favorite"
                android:layout_width="@dimen/fs_19"
                android:layout_height="@dimen/fs_19"
                android:background="@drawable/state_favorite"
                android:contentDescription="@string/todo" />
        </LinearLayout>

        <include layout="@layout/view_icon_direction"
            android:visibility="gone"
            />


    </RelativeLayout>


    <include
        layout="@layout/view_vendor_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/item_review_main_single_category_rl_logo" />


</RelativeLayout>
