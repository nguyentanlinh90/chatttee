<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_top_ten_review"
    android:id="@+id/frag_review_list_review_ll_parent"
    android:orientation="vertical">

    <include layout="@layout/item_review_general" />

    <RelativeLayout
        android:id="@+id/frag_vendor_detail_ll_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/fs_15">

        <TextView
            android:id="@+id/frag_review_top_review_tv_name"
            style="@style/TCTextViewDefault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/fs_5"
            android:layout_toStartOf="@+id/ll_right"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="@dimen/ts_12" />
        <LinearLayout
            android:id="@+id/ll_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/frag_review_top_review_ll_like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/fs_15"
                    android:layout_height="@dimen/fs_15"
                    android:contentDescription="@string/todo"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_like_gold" />

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fs_3"
                    android:gravity="center_vertical">

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/fs_3"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        tools:ignore="UselessParent">

                        <TextView
                            android:id="@+id/frag_list_review_tv_total_like"
                            style="@style/TCTextViewBlackBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:text="@string/text_zero"
                            android:textSize="@dimen/ts_11" />

                        <TextView
                            android:id="@+id/frag_list_review_tv_like"
                            style="@style/TCTextViewGrayLight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/frag_list_review_tv_total_like"
                            android:layout_marginTop="-5dp"
                            android:text="@string/review_like"
                            android:textSize="@dimen/ts_11" />
                    </RelativeLayout>
                </RelativeLayout>
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/fs_15"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/fs_15"
                android:contentDescription="@string/todo"
                android:src="@drawable/ic_logo_not_text" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_3"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/frag_list_review_tv_tip_amount"
                    style="@style/TCTextViewBlackBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:text="@string/text_zero"
                    android:textSize="@dimen/ts_11" />

                <TextView
                    style="@style/TCTextViewGrayLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/frag_list_review_tv_tip_amount"
                    android:layout_marginTop="-5dp"
                    android:text="@string/tee_coin_symbol"
                    android:textSize="@dimen/ts_11" />
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
    <TextView
        android:id="@+id/frag_vendor_detail_tv_from_google"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fs_10"
        android:padding="@dimen/fs_10"
        android:text="@string/text_from_google"
        android:textColor="@color/c_0e61fd"
        android:visibility="gone" />
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/fs_20"
        android:background="@color/c_f2f2f2" />
</LinearLayout>
