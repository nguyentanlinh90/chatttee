<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_f2f2f2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_40"
            android:background="@android:color/white"
            android:orientation="vertical"
            android:paddingStart="@dimen/fs_30">

            <LinearLayout
                android:id="@+id/frg_payment_threshold_ll_switch"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fs_45"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_payment_threshold" />

                <TextView
                    style="@style/TCTextViewBlack"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/fs_10"
                    android:gravity="center_vertical"
                    android:text="@string/text_payment_threshold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="end|center_vertical"
                    android:orientation="vertical">

                    <Switch
                        android:id="@+id/frg_payment_threshold_sw_payment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/fs_10" />
                </LinearLayout>
            </LinearLayout>

            <include layout="@layout/view_line" />

            <RelativeLayout
                android:id="@+id/frg_paymet_threshold_ll_maximum"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fs_45">

                <TextView
                    style="@style/TCTextViewBlack"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:text="@string/payment_threshold_maximum" />

                <ImageView
                    android:id="@+id/iv_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/fs_10"
                    android:src="@drawable/ic_next_gray_24pt" />

                <TextView
                    android:id="@+id/frg_payment_threshold_tv_maximum_currency"
                    style="@style/TCTextViewBlack"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/fs_5"
                    android:layout_toStartOf="@+id/iv_next"
                    android:gravity="center"
                    android:text="@string/tee_coin_symbol" />

                <TextView
                    android:id="@+id/frg_payment_threshold_tv_maximum"
                    style="@style/TCTextViewBlack"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/fs_5"
                    android:layout_toStartOf="@+id/frg_payment_threshold_tv_maximum_currency"
                    android:gravity="center"
                    android:text="@string/text_zero" />
            </RelativeLayout>
        </LinearLayout>

        <include layout="@layout/view_line" />
    </LinearLayout>
</android.support.v4.widget.NestedScrollView>
