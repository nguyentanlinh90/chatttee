<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_history_gold"
    android:layout_width="match_parent"
    android:layout_height="@dimen/fs_45"
    android:background="@drawable/bg_gold_solid_no_border_30_radius"
    android:gravity="center"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="@dimen/fs_27"
        android:layout_height="@dimen/fs_27"
        android:layout_gravity="center"
        android:contentDescription="@string/todo"
        android:src="@drawable/ic_list_white" />

    <TextView
        style="@style/TCTextViewWhite"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/fs_15"
        android:gravity="center"
        android:text="@string/text_history"
        android:textAllCaps="true" />
</LinearLayout>
