<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/LinearLayoutVerticalParent">

    <LinearLayout
        style="@style/LinearLayoutHorizontalFullWidth"
        android:layout_gravity="center_vertical"
        android:layout_margin="@dimen/fs_10"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="@dimen/fs_15"
            android:layout_height="@dimen/fs_15"
            android:contentDescription="@string/todo"
            android:src="@drawable/ic_notification_gold" />

        <TextView
            style="@style/TCTextViewGray"
            android:layout_marginStart="@dimen/fs_10"
            android:text="@string/shop_coinback_setting_title" />
    </LinearLayout>

    <LinearLayout
        style="@style/LinearLayoutHorizontalFullWidth"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="@dimen/fs_10"
        android:layout_marginStart="@dimen/fs_10"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="@dimen/fs_15"
            android:layout_height="@dimen/fs_15"
            android:contentDescription="@string/todo"
            android:src="@drawable/ic_tip" />

        <TextView
            style="@style/TCTextViewGold"
            android:layout_marginStart="@dimen/fs_10"
            android:text="@string/the_minimum_coinback_percentage_must_be_1_and_less_than_100" />
    </LinearLayout>

    <TextView
        style="@style/TCTextViewBlackBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fs_12"
        android:layout_marginTop="@dimen/fs_15"
        android:text="@string/coinback_percentage" />

    <LinearLayout
        style="@style/LinearLayoutHorizontalFullWidth"
        android:layout_height="@dimen/fs_50"
        android:layout_marginStart="@dimen/fs_12"
        android:layout_marginEnd="@dimen/fs_15"
        android:layout_marginTop="@dimen/fs_7">

        <EditText
            android:id="@+id/frg_coinback_setting_et_coinback"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_gray_solid_gray_border_5_radius"
            android:enabled="false"
            android:inputType="numberDecimal"
            android:paddingStart="@dimen/fs_10"
            android:text="0"
            android:textColor="@color/c_d2d2d2"
            tools:ignore="RtlSymmetry" />

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/fs_25"
            android:layout_weight="1">

            <com.teecoin.ui.SwitchButton
                android:id="@+id/frg_coinback_setting_sw_coinback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:sb_background="@color/c_868686"
                app:sb_checked="false"
                app:sb_checked_color="@color/c_b2973f"
                app:sb_show_indicator="false" />

        </RelativeLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/fs_50"
        android:orientation="vertical">

        <include layout="@layout/button_update" />
    </LinearLayout>

</LinearLayout>
