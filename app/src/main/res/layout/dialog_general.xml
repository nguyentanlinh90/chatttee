<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="17dp"
    android:layout_marginBottom="24dp"
    android:layout_marginRight="17dp"
    android:layout_marginTop="24dp"
    android:background="@drawable/bg_white_solid_no_border_5_radius">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:ignore="UselessParent">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/fs_30"
            android:contentDescription="@string/todo"
            android:src="@drawable/ic_message_base_dialog" />

        <TextView
            android:id="@+id/general_dialog_tv_title"
            style="@style/TCTextViewGrayBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/fs_10"
            android:layout_marginStart="@dimen/fs_10"
            android:layout_marginTop="@dimen/fs_15"
            android:gravity="center"
            android:textAllCaps="true"
            android:textSize="@dimen/ts_16" />

        <TextView
            android:id="@+id/general_dialog_tv_message"
            style="@style/TCTextViewBlack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/fs_40"
            android:layout_marginEnd="@dimen/fs_10"
            android:layout_marginStart="@dimen/fs_10"
            android:layout_marginTop="@dimen/fs_20"
            android:gravity="center_horizontal"
            android:lineSpacingExtra="@dimen/fs_7"
            android:textSize="@dimen/ts_14" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/fs_20"
        android:layout_marginEnd="@dimen/fs_10"
        android:layout_marginStart="@dimen/fs_10"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:measureWithLargestChild="true"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.25"
                android:orientation="horizontal"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/general_dialog_bt_no"
                android:layout_width="0dp"
                android:layout_height="@dimen/fs_40"
                android:layout_marginStart="@dimen/fs_5"
                android:layout_marginEnd="@dimen/fs_5"
                android:layout_weight="1">

                <!--<Button-->
                <!--android:id="@+id/general_dialog_tv_no"-->
                <!--android:layout_width="match_parent"-->
                <!--android:layout_height="match_parent"-->
                <!--android:background="@android:color/transparent"-->
                <!--android:maxLines="2"-->
                <!--android:textAllCaps="false" />-->

                <TextView
                    android:id="@+id/general_dialog_tv_no"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    style="@style/TCTextViewGold"
                    android:background="@drawable/bg_white_solid_gold_border_30_radius"
                    android:gravity="center"
                    android:padding="@dimen/fs_5"
                    android:text="@string/text_no"
                    android:textAllCaps="true"
                    android:textSize="@dimen/ts_13" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/general_dialog_bt_cancel"
                android:layout_width="0dp"
                android:layout_height="@dimen/fs_40"
                android:layout_marginStart="@dimen/fs_5"
                android:layout_marginEnd="@dimen/fs_5"
                android:layout_weight="1">

                <!--<Button-->
                <!--android:id="@+id/general_dialog_tv_cancel"-->
                <!--android:layout_width="match_parent"-->
                <!--android:layout_height="match_parent"-->
                <!--android:background="@android:color/transparent"-->
                <!--android:maxLines="2"-->
                <!--android:textAllCaps="false" />-->

                <TextView
                    android:id="@+id/general_dialog_tv_cancel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_white_solid_gold_border_30_radius"
                    style="@style/TCTextViewGold"
                    android:gravity="center"
                    android:maxLines="2"
                    android:padding="@dimen/fs_5"
                    android:text="@string/text_cancel"
                    android:textAllCaps="true"
                    android:textSize="@dimen/ts_13" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/general_dialog_bt_yes"
                android:layout_width="0dp"
                android:layout_height="@dimen/fs_40"
                android:layout_marginStart="@dimen/fs_5"
                android:layout_marginEnd="@dimen/fs_5"
                android:layout_weight="1">

                <!--<Button-->
                <!--android:id="@+id/general_dialog_tv_yes"-->
                <!--android:layout_width="match_parent"-->
                <!--android:layout_height="match_parent"-->
                <!--android:background="@android:color/transparent"-->
                <!--android:maxLines="2"-->
                <!--android:textAllCaps="false" />-->

                <TextView
                    android:id="@+id/general_dialog_tv_yes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    style="@style/TCTextViewWhite"
                    android:background="@drawable/bg_gold_solid_no_border_30_radius"
                    android:gravity="center"
                    android:padding="@dimen/fs_5"
                    android:text="@string/submit"
                    android:textAllCaps="true"
                    android:textSize="@dimen/ts_13">

                </TextView>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.25"
                android:orientation="horizontal"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>
</RelativeLayout>

