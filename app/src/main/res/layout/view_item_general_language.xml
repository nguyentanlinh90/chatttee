<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="@dimen/fs_15">

    <TextView
        android:id="@+id/view_item_general_language_tv_language_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        style="@style/TCTextViewBlack"
        android:textSize="@dimen/ts_13" />

    <ImageView
        android:id="@+id/view_item_general_language_iv_language_selected"
        style="@style/iv_check_language"
        tools:ignore="ContentDescription" />
</RelativeLayout>