<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/view_header_vendor_info"
    android:layout_width="match_parent"
    android:layout_height="@dimen/fs_250"
    android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

    <android.support.design.widget.CollapsingToolbarLayout
        android:id="@+id/collapsing_toolbar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:collapsedTitleTextAppearance="@style/CollapsedTitle"
        app:expandedTitleMarginBottom="@dimen/fs_56"
        app:expandedTitleMarginEnd="0dp"
        app:expandedTitleMarginStart="@dimen/fs_15"
        app:expandedTitleTextAppearance="@style/ExpandedTitle"
        app:layout_scrollFlags="scroll|exitUntilCollapsed"
        app:title="">

        <ImageView
            android:id="@+id/frag_vendor_detail_iv_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/c_f2f2f2"
            android:contentDescription="@string/todo"
            android:fitsSystemWindows="true"
            android:scaleType="centerCrop"
            app:layout_collapseMode="parallax"
            app:layout_collapseParallaxMultiplier="0.6"
            app:layout_scrollFlags="scroll" />
        <!--background-->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/c_75000000"
            app:layout_collapseMode="parallax"
            app:layout_collapseParallaxMultiplier="0.6"
            app:layout_scrollFlags="scroll|exitUntilCollapsed" />

        <android.support.v7.widget.Toolbar
            android:id="@+id/frg_coupon_user_my_coupon_detail_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:layout_marginBottom="@dimen/fs_45"
            android:layout_marginStart="-5dp"
            app:contentInsetStartWithNavigation="0dp"
            app:layout_collapseMode="pin"
            app:navigationIcon="@drawable/ic_back_white_black_shadow"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

        <RelativeLayout
            android:id="@+id/frag_vendor_rl_rating_write_review_for_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="@dimen/fs_10"
            android:layout_marginStart="@dimen/fs_15"
            android:gravity="bottom"
            app:contentInsetStartWithNavigation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="@dimen/fs_5"
                android:layout_toStartOf="@+id/frag_vendor_ll_write_review"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/frag_vendor_iv_logo"
                    android:layout_width="@dimen/fs_40"
                    android:layout_height="@dimen/fs_40"
                    android:contentDescription="@string/text_to"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_cover_chattee"
                    android:visibility="visible" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fs_3"
                    android:orientation="vertical">

                    <me.zhanghai.android.materialratingbar.MaterialRatingBar
                        android:id="@+id/frag_vendor_rating_bar"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/fs_20"
                        android:layout_marginTop="@dimen/fs_5"
                        android:rating="0"
                        android:stepSize="0.5" />

                    <TextView
                        android:id="@+id/frag_vendor_tv_cuisine_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/text_text"
                        android:visibility="gone" />
                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/frag_vendor_ll_write_review"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/fs_10"
                android:background="@drawable/bg_white_solid_no_border_30_radius"
                android:paddingEnd="@dimen/fs_15"
                android:paddingStart="@dimen/fs_15"
                tools:ignore="RelativeOverlap">

                <ImageView
                    android:layout_width="@dimen/fs_20"
                    android:layout_height="@dimen/fs_27"
                    android:layout_gravity="center"
                    android:contentDescription="@string/todo"
                    android:src="@drawable/ic_pen_1" />

                <TextView
                    style="@style/TCTextViewBlack"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/fs_10"
                    android:gravity="center"
                    android:text="@string/vendor_detail_write_a_review" />
            </LinearLayout>
        </RelativeLayout>
    </android.support.design.widget.CollapsingToolbarLayout>
</android.support.design.widget.AppBarLayout>
