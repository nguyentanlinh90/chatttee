<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_f2f2f2"
    android:clickable="true"
    android:fitsSystemWindows="true"
    android:focusable="true">

    <android.support.v4.widget.NestedScrollView
        android:id="@+id/frag_list_review_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            tools:ignore="UselessParent">

            <com.nex3z.flowlayout.FlowLayout
                android:id="@+id/frg_list_review_fl_filters_selected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/fs_15"
                app:flRowSpacing="8dp">

            </com.nex3z.flowlayout.FlowLayout>

            <com.teecoin.ui.TCRecyclerView
                android:id="@+id/frg_review_rcv_list_review"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fs_5"
                android:visibility="visible"
                app:layoutManager="android.support.v7.widget.LinearLayoutManager"
                tools:listitem="@layout/item_list_reviews" />

            <TextView
                android:id="@+id/tv_list_empty"
                style="@style/TCTextViewHeader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/no_result"
                android:visibility="gone" />


        </LinearLayout>
    </android.support.v4.widget.NestedScrollView>
</FrameLayout>
