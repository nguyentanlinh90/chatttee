<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout style="@style/LinearLayoutVerticalParent">

        <ImageView
            android:layout_width="@dimen/fs_100"
            android:layout_height="@dimen/fs_100"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/fs_50"
            android:contentDescription="@string/todo"
            android:src="@drawable/ic_check_success" />

        <TextView
            style="@style/TCTextViewGoldBoldLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_20"
            android:gravity="center"
            android:text="@string/coupon_successful" />

        <LinearLayout
            style="@style/view_group_discover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_20"
            android:orientation="vertical"
            android:paddingStart="@dimen/fs_0">

            <LinearLayout
                style="@style/LinearLayoutHorizontalFullWidth"
                android:layout_margin="@dimen/fs_15">

                <TextView
                    style="@style/TCTextViewBlack"
                    android:text="@string/merchant" />

                <TextView
                    android:id="@+id/frag_user_payment_success_tv_merchant"
                    style="@style/TCTextViewBlackBold"
                    android:layout_width="match_parent"
                    android:layout_marginStart="@dimen/fs_15"
                    android:ellipsize="end"
                    android:gravity="right"
                    android:maxLines="1"
                    android:text="@string/merchant"
                    android:textSize="@dimen/fs_13"
                    tools:ignore="RtlHardcoded,SpUsage" />

            </LinearLayout>

            <include layout="@layout/view_line" />

            <LinearLayout
                style="@style/LinearLayoutHorizontalFullWidth"
                android:layout_marginEnd="@dimen/fs_15"
                android:layout_marginStart="@dimen/fs_15"
                android:layout_marginTop="@dimen/fs_15">

                <TextView
                    style="@style/TCTextViewBlack"
                    android:text="@string/total_bill" />

                <TextView
                    android:id="@+id/frag_user_payment_success_tv_total_bill"
                    style="@style/TCTextViewBlackBold"
                    android:layout_width="match_parent"
                    android:layout_marginStart="@dimen/fs_15"
                    android:gravity="right"
                    android:text="@string/text_zero"
                    android:textSize="@dimen/fs_13"
                    tools:ignore="RtlHardcoded,SpUsage" />

            </LinearLayout>

            <LinearLayout
                style="@style/LinearLayoutHorizontalFullWidth"
                android:layout_marginEnd="@dimen/fs_15"
                android:layout_marginStart="@dimen/fs_15"
                android:layout_marginTop="@dimen/fs_15">

                <TextView
                    style="@style/TCTextViewBlack"
                    android:text="@string/amount_paid_by_wallet" />

                <TextView
                    android:id="@+id/frag_user_payment_success_tv_amount_wallet"
                    style="@style/TCTextViewGoldBold"
                    android:layout_width="match_parent"
                    android:layout_marginStart="@dimen/fs_15"
                    android:gravity="right"
                    android:text="@string/text_zero"
                    android:textSize="@dimen/fs_13"
                    tools:ignore="RtlHardcoded,SpUsage" />

            </LinearLayout>

            <TextView
                android:id="@+id/frag_user_payment_success_tv_converd_to_tec"
                style="@style/TCTextViewBlackBold"
                android:layout_width="match_parent"
                android:layout_marginEnd="@dimen/fs_15"
                android:layout_marginTop="@dimen/fs_15"
                android:gravity="right"
                android:text="@string/text_zero"
                android:textSize="@dimen/fs_13"
                tools:ignore="RtlHardcoded,SpUsage" />


            <LinearLayout
                style="@style/LinearLayoutHorizontalFullWidth"
                android:layout_margin="@dimen/fs_15">

                <TextView
                    style="@style/TCTextViewBlack"
                    android:text="@string/text_fee" />

                <TextView
                    android:id="@+id/frag_user_payment_success_tv_fee"
                    style="@style/TCTextViewGoldBold"
                    android:layout_width="match_parent"
                    android:layout_marginStart="@dimen/fs_15"
                    android:gravity="right"
                    android:text="@string/text_zero"
                    android:textSize="@dimen/fs_13"
                    tools:ignore="RtlHardcoded,SpUsage" />

            </LinearLayout>

            <include layout="@layout/view_line" />

            <LinearLayout
                style="@style/LinearLayoutHorizontalFullWidth"
                android:layout_margin="@dimen/fs_15">

                <TextView
                    style="@style/TCTextViewBlack"
                    android:text="@string/amount_paid_by_cash" />

                <TextView
                    android:id="@+id/frag_user_payment_success_tv_amount_cash"
                    style="@style/TCTextViewBlackBold"
                    android:layout_width="match_parent"
                    android:layout_marginStart="@dimen/fs_15"
                    android:gravity="right"
                    android:text="@string/text_zero"
                    android:textSize="@dimen/fs_13"
                    tools:ignore="RtlHardcoded,SpUsage" />

            </LinearLayout>

            <LinearLayout
                style="@style/LinearLayoutHorizontalFullWidth"
                android:layout_gravity="center_vertical"
                android:layout_marginBottom="@dimen/fs_10"
                android:layout_marginEnd="@dimen/fs_15"
                android:layout_marginStart="@dimen/fs_5"
                android:layout_marginTop="@dimen/fs_5"
                android:gravity="center_vertical"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/fs_25"
                    android:layout_height="@dimen/fs_25"
                    android:contentDescription="@string/todo"
                    android:src="@drawable/ic_notification_gold" />

                <TextView
                    style="@style/TCTextViewGray"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fs_7"
                    android:text="@string/user_payment_success_text_note_user" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/frag_user_payment_success_v_coupon"
            style="@style/view_group_discover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_10"
            android:orientation="vertical">

            <RelativeLayout style="@style/view_header_group_discover">

                <TextView
                    style="@style/text_view_title_item_main_user"
                    android:text="@string/recommended_coupons_vouchers" />

                <include
                    android:id="@+id/frag_user_payment_success_v_all_coupon"
                    layout="@layout/view_all" />

            </RelativeLayout>

            <com.teecoin.ui.TCRecyclerView
                android:id="@+id/frag_user_payment_success_rcv_coupon"
                style="@style/recycler_view_item_main_user"
                app:layoutManager="android.support.v7.widget.LinearLayoutManager"
                tools:listitem="@layout/item_vendor" />

        </LinearLayout>

        <TextView
            android:id="@+id/frag_user_payment_success_tv_back_to_wallet"
            style="@style/TCTextViewWhite"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fs_39"
            android:layout_marginBottom="@dimen/fs_25"
            android:layout_marginEnd="@dimen/fs_50"
            android:layout_marginStart="@dimen/fs_50"
            android:layout_marginTop="@dimen/fs_20"
            android:background="@drawable/bg_gold_solid_no_border_30_radius"
            android:gravity="center"
            android:text="@string/back_to_my_wallet"
            android:textAllCaps="true" />

    </LinearLayout>

</android.support.v4.widget.NestedScrollView>
