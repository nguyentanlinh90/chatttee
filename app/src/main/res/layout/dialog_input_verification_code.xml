<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="@dimen/fs_31"
        android:layout_marginEnd="@dimen/fs_31"
        android:background="@drawable/bg_white_solid_no_border_5_radius"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_60"
            android:layout_marginBottom="@dimen/fs_20"
            style="@style/TCTextViewGoldBold"
            android:gravity="center_horizontal"
            android:text="@string/verification_code"
            android:textAllCaps="true"
            android:textSize="@dimen/ts_16" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fs_16"
            style="@style/TCTextViewBlack"
            android:gravity="center_horizontal"
            android:lineSpacingExtra="@dimen/fs_7"
            android:paddingStart="@dimen/fs_39"
            android:paddingEnd="@dimen/fs_39"
            android:text="@string/please_enter_the_verification_code_that_have_been_sent_to_your_registered_email"
            android:textSize="@dimen/ts_12" />

        <include
            layout="@layout/view_input_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fs_50"
            android:layout_marginEnd="@dimen/fs_50" />

        <TextView
            android:id="@+id/dialog_input_verification_code_tv_error_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="@dimen/fs_30"
            android:layout_marginTop="@dimen/fs_10"
            android:layout_marginEnd="@dimen/fs_30"
            android:textColor="@color/c_f15357"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dialog_input_verification_code_tv_resend_count_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/fs_20"
            android:background="@drawable/bg_gray_solid_no_border_30_radius"
            android:paddingStart="@dimen/fs_30"
            android:paddingTop="@dimen/fs_10"
            android:paddingEnd="@dimen/fs_30"
            android:paddingBottom="@dimen/fs_10"
            android:textColor="@color/c_b2973f"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dialog_input_verification_code_tv_resend"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/fs_39"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/fs_20"
            android:background="@drawable/bg_white_solid_gold_border_30_radius"
            android:gravity="center"
            android:paddingStart="@dimen/fs_30"
            android:paddingEnd="@dimen/fs_30"
            android:text="@string/verify_phone_number_resend"
            android:textAllCaps="true"
            android:textColor="@color/c_b2973f"
            android:visibility="gone" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_24"
            android:layout_marginBottom="@dimen/fs_20"
            android:orientation="horizontal">

            <include layout="@layout/button_left" />

            <include layout="@layout/button_right" />

        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
