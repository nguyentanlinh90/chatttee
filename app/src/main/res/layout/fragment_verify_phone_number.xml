<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:focusable="true"
    android:background="@android:color/white"
    android:clickable="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/frag_verify_code_tv_send_to_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TCTextViewBlack"
        android:layout_marginTop="@dimen/fs_80"
        android:layout_marginEnd="@dimen/fs_30"
        android:layout_marginStart="@dimen/fs_30"
        android:gravity="center"
        android:text="@string/verify_phone_number_message_code_to_phone" />

    <TextView
        android:id="@+id/frag_verify_code_tv_wrong_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TCTextViewBlack"
        android:layout_marginEnd="@dimen/fs_30"
        android:layout_marginTop="@dimen/fs_20"
        android:text="@string/verify_phone_number_message_wrong"
        android:layout_marginStart="@dimen/fs_30"
        android:textColor="@color/c_f15357"
        android:gravity="center"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/fs_37"
        android:layout_marginTop="@dimen/fs_20"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/frg_coupon_user_validation_code_et_validation_code_1"
            style="@style/validation_code_edit_text"
            tools:ignore="Autofill,LabelFor" />

        <EditText
            android:id="@+id/frg_coupon_user_validation_code_et_validation_code_2"
            style="@style/validation_code_edit_text"
            tools:ignore="Autofill,LabelFor" />

        <EditText
            android:id="@+id/frg_coupon_user_validation_code_et_validation_code_3"
            style="@style/validation_code_edit_text"
            tools:ignore="Autofill,LabelFor" />

        <EditText
            android:id="@+id/frg_coupon_user_validation_code_et_validation_code_4"
            style="@style/validation_code_edit_text"
            tools:ignore="Autofill,LabelFor" />

        <EditText
            android:id="@+id/frg_coupon_user_validation_code_et_validation_code_5"
            style="@style/validation_code_edit_text"
            tools:ignore="Autofill,LabelFor" />

        <EditText
            android:id="@+id/frg_coupon_user_validation_code_et_validation_code_6"
            style="@style/validation_code_edit_text"
            tools:ignore="Autofill,LabelFor" />
    </LinearLayout>

    <TextView
        android:id="@+id/frag_verify_code_tv_resend_in"
        style="@style/TCTextViewWhite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/fs_20"
        android:background="@drawable/bg_gold_solid_no_border_30_radius"
        android:gravity="center"
        android:paddingEnd="@dimen/fs_20"
        android:paddingStart="@dimen/fs_20"
        android:paddingBottom="@dimen/fs_2"
        android:paddingTop="@dimen/fs_2"
        android:text="@string/verify_phone_number_resend"
        android:textSize="@dimen/ts_12_8"
        android:visibility="visible" />

    <EditText
        android:id="@+id/frg_coupon_user_validation_code_et_validation_code_hidden"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:contentDescription="@string/todo"
        android:inputType="number"
        android:maxLength="6"
        tools:ignore="Autofill,LabelFor,TextFields" />
</LinearLayout>
