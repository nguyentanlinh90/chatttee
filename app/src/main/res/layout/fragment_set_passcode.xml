<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_set_passcode"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/frg_set_pass_code_ll_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/frg_set_passcode_tv_cancel"
                style="@style/TCTextViewWhiteBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/fs_10"
                android:padding="@dimen/fs_5"
                android:text="@string/text_cancel"
                android:textSize="@dimen/ts_16" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/frg_set_pass_code_ll_enter_passcode_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fs_20"
            android:gravity="center"
            android:layout_below="@+id/frg_set_pass_code_ll_cancel"
            android:orientation="vertical">

            <TextView
                android:id="@+id/frg_set_passcode_tv_enter_code"
                style="@style/TCTextViewWhite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/enter_your_new_passcode" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/frg_set_pass_code_ll_entered_passcode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_below="@+id/frg_set_pass_code_ll_enter_passcode_text"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/frg_set_passcode_iv_code_1"
                android:layout_width="@dimen/fs_15"
                android:layout_height="@dimen/fs_15"
                android:layout_marginEnd="@dimen/fs_20"
                android:background="@drawable/passcode_selector" />

            <ImageView
                android:id="@+id/frg_set_passcode_iv_code_2"
                android:layout_width="@dimen/fs_15"
                android:layout_height="@dimen/fs_15"
                android:layout_marginEnd="@dimen/fs_20"
                android:background="@drawable/passcode_selector" />

            <ImageView
                android:id="@+id/frg_set_passcode_iv_code_3"
                android:layout_width="@dimen/fs_15"
                android:layout_height="@dimen/fs_15"
                android:layout_marginEnd="@dimen/fs_20"
                android:background="@drawable/passcode_selector" />

            <ImageView
                android:id="@+id/frg_set_passcode_iv_code_4"
                android:layout_width="@dimen/fs_15"
                android:layout_height="@dimen/fs_15"
                android:background="@drawable/passcode_selector" />

        </LinearLayout>

        <TextView
            android:id="@+id/frg_set_passcode_tv_no_match"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_10"
            style="@style/TCTextViewWhite"
            android:text="@string/set_passcode_not_match"
            android:gravity="center"
            android:visibility="invisible"
            android:layout_below="@+id/frg_set_pass_code_ll_entered_passcode" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginLeft="@dimen/fs_8"
            android:layout_marginRight="@dimen/fs_8"
            android:layout_marginTop="@dimen/fs_20"
            android:gravity="center"
            android:layout_centerInParent="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/fs_67"
                android:gravity="center"
                android:layout_marginTop="@dimen/fs_20"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fs_67"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center">

                        <RelativeLayout
                            android:id="@+id/frg_set_passcode_rl_1"
                            android:layout_width="@dimen/fs_67"
                            android:layout_height="@dimen/fs_67"
                            android:background="@drawable/number_passcode_selector">

                            <TextView
                                android:id="@+id/frg_set_passcode_tv_num_1"
                                style="@style/TCTextViewNumberPasscode"
                                android:layout_width="@dimen/fs_67"
                                android:layout_height="@dimen/fs_67"
                                android:text="1" />
                        </RelativeLayout>
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center">

                        <RelativeLayout
                            android:id="@+id/frg_set_passcode_rl_2"
                            android:layout_width="@dimen/fs_67"
                            android:layout_height="@dimen/fs_67"
                            android:background="@drawable/number_passcode_selector">

                            <TextView
                                android:id="@+id/frg_set_passcode_tv_num_2"
                                style="@style/TCTextViewNumberPasscode"
                                android:layout_width="@dimen/fs_67"
                                android:layout_height="@dimen/fs_67"
                                android:text="2"

                                />
                        </RelativeLayout>

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center">

                        <RelativeLayout
                            android:id="@+id/frg_set_passcode_rl_3"
                            android:layout_width="@dimen/fs_67"
                            android:layout_height="@dimen/fs_67"
                            android:background="@drawable/number_passcode_selector">

                            <TextView
                                android:id="@+id/frg_set_passcode_tv_num_3"
                                style="@style/TCTextViewNumberPasscode"
                                android:layout_width="@dimen/fs_67"
                                android:layout_height="@dimen/fs_67"
                                android:text="3"

                                />
                        </RelativeLayout>

                    </RelativeLayout>
                </LinearLayout>

            </LinearLayout>
            <!--**********************-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/fs_67"
                android:layout_marginTop="@dimen/fs_20"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fs_67"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center">

                        <RelativeLayout
                            android:id="@+id/frg_set_passcode_rl_4"
                            android:layout_width="@dimen/fs_67"
                            android:layout_height="@dimen/fs_67"
                            android:background="@drawable/number_passcode_selector">

                            <TextView
                                android:id="@+id/frg_set_passcode_tv_num_4"
                                style="@style/TCTextViewNumberPasscode"
                                android:layout_width="@dimen/fs_67"
                                android:layout_height="@dimen/fs_67"
                                android:text="4" />
                        </RelativeLayout>
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center">

                        <RelativeLayout
                            android:id="@+id/frg_set_passcode_rl_5"
                            android:layout_width="@dimen/fs_67"
                            android:layout_height="@dimen/fs_67"
                            android:background="@drawable/number_passcode_selector">

                            <TextView
                                android:id="@+id/frg_set_passcode_tv_num_5"
                                style="@style/TCTextViewNumberPasscode"
                                android:layout_width="@dimen/fs_67"
                                android:layout_height="@dimen/fs_67"
                                android:text="5"

                                />
                        </RelativeLayout>

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center">

                        <RelativeLayout
                            android:id="@+id/frg_set_passcode_rl_6"
                            android:layout_width="@dimen/fs_67"
                            android:layout_height="@dimen/fs_67"
                            android:background="@drawable/number_passcode_selector">

                            <TextView
                                android:id="@+id/frg_set_passcode_tv_num_6"
                                style="@style/TCTextViewNumberPasscode"
                                android:layout_width="@dimen/fs_67"
                                android:layout_height="@dimen/fs_67"
                                android:text="6" />
                        </RelativeLayout>

                    </RelativeLayout>
                </LinearLayout>

            </LinearLayout>
            <!--*******************-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/fs_67"
                android:layout_marginTop="@dimen/fs_20"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fs_67"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center">

                        <RelativeLayout
                            android:id="@+id/frg_set_passcode_rl_7"
                            android:layout_width="@dimen/fs_67"
                            android:layout_height="@dimen/fs_67"
                            android:background="@drawable/number_passcode_selector">

                            <TextView
                                android:id="@+id/frg_set_passcode_tv_num_7"
                                style="@style/TCTextViewNumberPasscode"
                                android:layout_width="@dimen/fs_67"
                                android:layout_height="@dimen/fs_67"
                                android:text="7" />
                        </RelativeLayout>
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center">

                        <RelativeLayout
                            android:id="@+id/frg_set_passcode_rl_8"
                            android:layout_width="@dimen/fs_67"
                            android:layout_height="@dimen/fs_67"
                            android:background="@drawable/number_passcode_selector">

                            <TextView
                                android:id="@+id/frg_set_passcode_tv_num_8"
                                style="@style/TCTextViewNumberPasscode"
                                android:layout_width="@dimen/fs_67"
                                android:layout_height="@dimen/fs_67"
                                android:text="8" />
                        </RelativeLayout>

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center">

                        <RelativeLayout
                            android:id="@+id/frg_set_passcode_rl_9"
                            android:layout_width="@dimen/fs_67"
                            android:layout_height="@dimen/fs_67"
                            android:background="@drawable/number_passcode_selector">

                            <TextView
                                android:id="@+id/frg_set_passcode_tv_num_9"
                                style="@style/TCTextViewNumberPasscode"
                                android:layout_width="@dimen/fs_67"
                                android:layout_height="@dimen/fs_67"
                                android:text="9" />
                        </RelativeLayout>

                    </RelativeLayout>
                </LinearLayout>

            </LinearLayout>
            <!--************************-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/fs_67"
                android:layout_marginTop="@dimen/fs_20"
                android:gravity="center"
                android:orientation="horizontal">

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center">

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center">

                    <RelativeLayout
                        android:id="@+id/frg_set_passcode_rl_0"
                        android:layout_width="@dimen/fs_67"
                        android:layout_height="@dimen/fs_67"
                        android:background="@drawable/number_passcode_selector">

                        <TextView
                            android:id="@+id/frg_set_passcode_tv_num_0"
                            style="@style/TCTextViewNumberPasscode"
                            android:layout_width="@dimen/fs_67"
                            android:layout_height="@dimen/fs_67"
                            android:text="@string/text_zero" />
                    </RelativeLayout>

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center">

                    <RelativeLayout
                        android:id="@+id/frg_set_passcode_rl_delete"
                        android:layout_width="@dimen/fs_67"
                        android:layout_height="@dimen/fs_67"
                        android:background="@drawable/select_round_delete_passcode">

                        <ImageView
                            android:layout_width="@dimen/fs_30"
                            android:layout_height="@dimen/fs_67"
                            android:layout_centerInParent="true"
                            android:src="@drawable/ic_delete_pass" />

                        <!--android:background="@color/selector_white_gray"-->
                    </RelativeLayout>

                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/fs_30"
            android:gravity="center">

            <TextView
                android:id="@+id/frg_set_pass_code_tv_remove_passcode"
                style="@style/TCTextViewGoldBoldLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_remove_passcode" />

        </LinearLayout>
    </RelativeLayout>
</android.support.v4.widget.NestedScrollView>
