<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/fs_118"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/fs_10"
    android:paddingBottom="@dimen/fs_1"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/item_coupon_category_iv_image"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fs_92"
        android:contentDescription="@string/todo"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_cover_chattee" />

    <TextView
        android:id="@+id/item_coupon_category_tv_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/fs_5"
        android:layout_marginStart="@dimen/fs_5"
        android:layout_marginTop="@dimen/fs_6"
        android:ellipsize="end"
        android:fontFamily="@font/axis_std_regular"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/text_text"
        android:textStyle="bold"
        android:textColor="@drawable/categories_text_selector"
        android:textSize="@dimen/ts_12" />
</LinearLayout>
