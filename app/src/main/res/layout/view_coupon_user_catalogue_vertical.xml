<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:paddingStart="@dimen/fs_15"
    android:paddingTop="@dimen/fs_5"
    android:visibility="visible"
    tools:ignore="RtlSymmetry">

    <com.teecoin.ui.TCRecyclerView
        android:id="@+id/item_coupon_user_catalogue_rcv_vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:nestedScrollingEnabled="false"
        app:layoutManager="android.support.v7.widget.LinearLayoutManager"
        tools:listitem="@layout/view_item_coupon_user_catalogue_vertical" />
    <include layout="@layout/view_no_data" />
    <include layout="@layout/view_no_coupon" />

</LinearLayout>
