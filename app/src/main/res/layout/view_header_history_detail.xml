<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/fs_30"
    android:layout_marginTop="@dimen/fs_30"
    android:background="@color/c_f2f2f2"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/frg_history_detail_tv_payment_id"
        style="@style/TCTextViewGoldBoldMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_three_dot" />

    <TextView
        android:id="@+id/frg_history_detail_tv_date"
        style="@style/TCTextViewBlackBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fs_10"
        android:text="@string/text_three_dot" />

    <TextView
        android:id="@+id/frg_history_detail_tv_rate"
        style="@style/TCTextViewBlackBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fs_10"
        android:text="@string/text_three_dot" />

</LinearLayout>
