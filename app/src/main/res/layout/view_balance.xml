<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <RelativeLayout
        style="@style/view_item_main_user"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fs_57"
        android:layout_marginBottom="@dimen/fs_7"
        android:layout_marginEnd="@dimen/fs_7"
        android:layout_marginStart="@dimen/fs_7"
        android:layout_marginTop="@dimen/fs_7"
        android:background="@color/c_ffffff"
        android:elevation="@dimen/fs_2">

        <ImageView
            android:id="@+id/view_balance_iv_wallet_icon"
            android:layout_width="@dimen/fs_25"
            android:layout_height="@dimen/fs_20"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/fs_10"
            android:contentDescription="@string/todo"
            android:src="@drawable/ic_tab_wallet_selector" />

        <TextView
            android:id="@+id/view_balance_tv_balance_text"
            style="@style/TCTextViewBlack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/fs_8"
            android:layout_toEndOf="@+id/view_balance_iv_wallet_icon"
            android:text="@string/text_balance_with_colon"
            android:textAllCaps="true"
            android:textSize="@dimen/ts_14"
            tools:ignore="RelativeOverlap" />

        <TextView
            android:id="@+id/view_balance_tv_balance_amount"
            style="@style/TCTextViewBlackBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginBottom="@dimen/fs_10"
            android:layout_marginEnd="@dimen/fs_5"
            android:layout_marginStart="@dimen/fs_2"
            android:layout_toEndOf="@+id/view_balance_tv_balance_text"
            android:text="@string/text_zero"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/view_balance_tv_balance_tec"
            style="@style/TCTextViewBlackBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginBottom="@dimen/fs_10"
            android:layout_marginEnd="@dimen/fs_5"
            android:layout_marginStart="@dimen/fs_2"
            android:layout_toEndOf="@+id/view_balance_tv_balance_amount"
            android:layout_toStartOf="@+id/view_balance_v_more_wallet"
            android:text="@string/tee_coin_symbol"
            android:textAllCaps="true"
            android:visibility="visible" />

        <include
            android:id="@+id/view_balance_v_more_wallet"
            layout="@layout/view_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>

</RelativeLayout>

