<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:ignore="MissingDefaultResource">

    <ImageView
        android:id="@+id/frg_coupon_user_validation_code_iv_shop_avatar"
        android:layout_width="@dimen/fs_62"
        android:layout_height="@dimen/fs_62"
        android:layout_marginTop="@dimen/fs_20"
        android:background="@drawable/ic_logo_chattee"
        android:contentDescription="@string/todo"
        android:scaleType="fitXY" />

    <TextView
        android:id="@+id/frg_coupon_user_validation_code_tv_shop_name"
        style="@style/TCTextViewBlackBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fs_10"
        android:text="@string/text_text" />

    <TextView
        android:id="@+id/frg_coupon_user_validation_code_tv_coupon_name"
        style="@style/TCTextViewGoldBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fs_5"
        android:text="@string/text_text" />

    <TextView
        android:id="@+id/frg_coupon_user_validation_code_tv_error_qr_code"
        style="@style/TCTextViewBlackBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fs_10"
        android:text="@string/qr_code_scanning_unsuccessful"
        android:textColor="@color/c_d0021b"
        android:visibility="visible" />

    <TextView
        style="@style/TCTextViewBlack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fs_10"
        android:text="@string/please_ask_the_cashier_to_enter_the_code" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/fs_37"
        android:layout_marginTop="@dimen/fs_20"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/frg_coupon_user_validation_code_et_validation_code_1"
            style="@style/validation_code_edit_text"
            tools:ignore="Autofill,LabelFor" />

        <EditText
            android:id="@+id/frg_coupon_user_validation_code_et_validation_code_2"
            style="@style/validation_code_edit_text"
            tools:ignore="Autofill,LabelFor" />

        <EditText
            android:id="@+id/frg_coupon_user_validation_code_et_validation_code_3"
            style="@style/validation_code_edit_text"
            tools:ignore="Autofill,LabelFor" />

        <EditText
            android:id="@+id/frg_coupon_user_validation_code_et_validation_code_4"
            style="@style/validation_code_edit_text"
            tools:ignore="Autofill,LabelFor" />

        <EditText
            android:id="@+id/frg_coupon_user_validation_code_et_validation_code_5"
            style="@style/validation_code_edit_text"
            tools:ignore="Autofill,LabelFor" />

        <EditText
            android:id="@+id/frg_coupon_user_validation_code_et_validation_code_6"
            style="@style/validation_code_edit_text"
            tools:ignore="Autofill,LabelFor" />
    </LinearLayout>

    <TextView
        android:id="@+id/frg_coupon_user_validation_code_tv_try_again"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fs_10"
        android:fontFamily="@font/axis_std_regular"
        android:gravity="center_horizontal"
        android:lineSpacingExtra="@dimen/fs_3_5"
        android:text="@string/did_you_enter_the_correct_code_let_try_again"
        android:textColor="@color/c_d0021b"
        android:textSize="@dimen/ts_12_8"
        android:visibility="gone" />

    <EditText
        android:id="@+id/frg_coupon_user_validation_code_et_validation_code_hidden"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:contentDescription="@string/todo"
        android:inputType="number"
        android:maxLength="6"
        tools:ignore="Autofill,LabelFor,TextFields" />
</LinearLayout>