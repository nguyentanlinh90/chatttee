<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/fs_10">

        <ImageView
            android:id="@+id/item_event_iv_event_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_referral_detail_item"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/item_event_iv_event_item"
            android:orientation="vertical"
            android:weightSum="3">

            <TextView
                android:id="@+id/item_event_tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Register from referral" />

            <TextView
                android:id="@+id/item_event_tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2018/08/30 10:22:30" />

        </LinearLayout>
    </RelativeLayout>

    <include layout="@layout/view_line" />
</LinearLayout>
