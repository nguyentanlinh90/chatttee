<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:paddingStart="@dimen/fs_20"
    android:paddingTop="@dimen/fs_20"
    android:paddingBottom="@dimen/fs_15">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dialog_coupon_user_confirm_purchase_coupon_iv_loading"
            android:layout_width="@dimen/fs_45"
            android:layout_height="@dimen/fs_45" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fs_5"
            android:orientation="vertical">

            <TextView
                style="@style/TCTextViewBlackBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/coupon_get_this_coupon" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fs_10"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dialog_coupon_user_confirm_purchase_coupon_tv_name_coupon"
                    style="@style/TCTextViewBlack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/coupon_purchase_coupon_with_tec" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/fs_35"
        android:layout_marginTop="@dimen/fs_20"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dialog_coupon_user_confirm_purchases_coupon_tv_cancel"
            style="@style/TCTextViewGold"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/fs_20"
            android:layout_weight="1"
            android:background="@drawable/bg_white_solid_gold_border_30_radius"
            android:gravity="center"
            android:text="@string/text_cancel"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/dialog_coupon_user_confirm_purchases_coupon_tv_confirm"
            style="@style/TCTextViewWhite"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/fs_20"
            android:layout_weight="1"
            android:background="@drawable/bg_gold_solid_no_border_30_radius"
            android:gravity="center"
            android:text="@string/confirm"
            android:textAllCaps="true" />
    </LinearLayout>

</LinearLayout>
