<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/item_vendor_tv_name"
        style="@style/TCTextViewBlackBold"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingBottom="@dimen/fs_0"
        android:text="@string/text_text"
        android:textSize="@dimen/ts_14" />

    <LinearLayout
        android:id="@+id/item_vendor_view_review"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/fs_15"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.teecoin.ui.SimpleRatingBar
            android:id="@+id/item_vendor_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srb_borderColor="@color/c_b2973f"
            app:srb_fillColor="@color/c_b2973f"
            app:srb_numberOfStars="5"
            app:srb_isIndicator="true"
            app:srb_pressedBorderColor="@color/c_b2973f"
            app:srb_pressedFillColor="@color/c_b2973f"
            app:srb_rating="0"
            app:srb_starBorderWidth="1"
            app:srb_starCornerRadius="1"
            app:srb_starSize="@dimen/fs_13"
            app:srb_stepSize="0.1" />

        <TextView
            android:id="@+id/item_vendor_tv_review"
            style="@style/TCTextViewBlack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/ts_10" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fs_3"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/item_vendor_tv_price_range"
            style="@style/TCTextViewBlack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:text="$"
            android:textSize="@dimen/ts_10" />

        <TextView
            android:id="@+id/item_vendor_tv_distance"
            style="@style/TCTextViewBlack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/fs_10"
            android:gravity="center_vertical"
            android:textSize="@dimen/ts_10" />

        <ImageView
            android:id="@+id/item_vendor_iv_is_coupon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/todo"
            android:src="@drawable/ic_coupon_category" />

        <ImageView
            android:id="@+id/item_vendor_iv_is_cash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fs_7"
            android:contentDescription="@string/todo"
            android:src="@drawable/ic_cash_voucher" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/item_vendor_tv_open_or_close"
            style="@style/TCTextViewBlack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:textColor="@color/c_42b766"
            android:textSize="@dimen/ts_10" />

        <TextView
            android:id="@+id/item_vendor_tv_dot"
            style="@style/TCTextViewBlack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="-3dp"
            android:gravity="center_vertical"
            android:text=" . "
            android:textSize="@dimen/ts_12"
            android:visibility="gone" />

        <TextView
            android:id="@+id/item_vendor_tv_open_or_close_time"
            style="@style/TCTextViewBlack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:textSize="@dimen/ts_10" />
    </LinearLayout>

    <TextView
        android:id="@+id/item_vendor_tv_cuisine"
        style="@style/TCTextViewBlack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textSize="@dimen/ts_10" />

    <RelativeLayout
        android:id="@+id/item_vendor_view_tec_check_in"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <TextView
            android:id="@+id/item_vendor_tv_num_tec"
            style="@style/TCTextViewGoldBold"
            android:text="@string/text_zero"

            />

        <TextView
            style="@style/TCTextViewBlack"
            android:layout_marginStart="@dimen/fs_1"
            android:layout_marginTop="@dimen/fs_2_5"
            android:layout_toEndOf="@+id/item_vendor_tv_num_tec"
            android:text="@string/tee_coin_symbol"
            android:textSize="@dimen/ts_10" />

        <TextView
            android:id="@+id/item_vendor_tv_num_check_in"
            style="@style/TCTextViewGoldBold"
            android:layout_toStartOf="@+id/item_vendor_tv_check"
            android:text="@string/text_zero" />

        <TextView
            android:id="@+id/item_vendor_tv_check"
            style="@style/TCTextViewBlack"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="@dimen/fs_1"
            android:layout_marginTop="@dimen/fs_2"
            android:layout_marginEnd="@dimen/fs_3"
            android:text="@string/text_check_in_lowercase"
            android:textSize="@dimen/ts_10" />
    </RelativeLayout>

</LinearLayout>
