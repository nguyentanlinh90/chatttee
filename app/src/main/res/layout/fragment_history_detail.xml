<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_f2f2f2"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/frg_history_detail_ll_root_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/view_header_history_detail" />


        <TextView
            android:id="@+id/frg_history_detail_tv_address"
            style="@style/TCTextViewBlack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:gravity="center"
            android:paddingBottom="@dimen/fs_8"
            android:paddingLeft="@dimen/fs_10"
            android:lineSpacingExtra="@dimen/fs_4"
            android:paddingRight="@dimen/fs_10"
            android:paddingTop="@dimen/fs_8" />

        <include layout="@layout/view_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:orientation="vertical"
            android:paddingBottom="@dimen/fs_25"
            android:paddingLeft="@dimen/fs_20"
            android:paddingRight="@dimen/fs_20"
            android:paddingTop="@dimen/fs_25">

            <LinearLayout
                android:id="@+id/frg_history_detail_ll_invoice_and_amount_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TCTextViewBlack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_invoice_id" />

                    <TextView
                        android:id="@+id/frg_history_detail_invoice_id"
                        style="@style/TCTextViewBlackMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/fs_1_5"
                        android:layout_marginTop="@dimen/fs_10"
                        android:text="@string/text_value_double" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/frg_history_detail_tv_amount_title"
                        style="@style/TCTextViewBlack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/general_amount" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/fs_10"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/frg_history_detail_tv_amount"
                            style="@style/TCTextViewBlackBoldMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_value_double" />

                        <TextView
                            android:id="@+id/frg_history_detail_tv_currency_amount"
                            style="@style/TCTextViewGrayBoldMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/fs_5"
                            android:text="@string/text_usd" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/frg_history_detail_coin_back_tv_convert_payment"
                        style="@style/TCTextViewGoldLight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/fs_3"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/frg_history_detail_rl_value_for_shop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fs_20"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/frg_history_detail_tv_payment_title"
                        style="@style/TCTextViewBlack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/input_payment_payment" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/fs_10"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/frg_history_detail_tv_payment"
                            style="@style/TCTextViewBlackBoldMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_value_double" />

                        <TextView
                            android:id="@+id/frg_history_detail_tv_currency_payment"
                            style="@style/TCTextViewBlackBoldMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/fs_5"
                            android:text="@string/text_usd" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/frg_history_detail_ll_fee"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TCTextViewBlack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_fee" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/fs_10"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/frg_history_detail_tv_fee"
                            style="@style/TCTextViewBlackBoldMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_value_double" />

                        <TextView
                            android:id="@+id/frg_history_detail_tv_currency_fee"
                            style="@style/TCTextViewGrayBoldMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/fs_5"
                            android:text="@string/text_usd" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/frg_history_detail_ll_transfer_money_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fs_20"
                android:baselineAligned="false"
                android:orientation="vertical">

                <TextView
                    style="@style/TCTextViewBlack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/transfer_money_note" />

                <TextView
                    android:id="@+id/frg_history_detail_tv_transfer_money_note"
                    style="@style/TCTextViewBlackBoldMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_three_dot" />
            </LinearLayout>

        </LinearLayout>

        <include layout="@layout/view_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:orientation="vertical"
            android:paddingBottom="@dimen/fs_25"
            android:paddingLeft="@dimen/fs_20"
            android:paddingRight="@dimen/fs_20"
            android:paddingTop="@dimen/fs_10">

            <RelativeLayout
                android:id="@+id/frg_history_detail_rl_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TCTextViewBlack1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_total_tec"
                    android:textSize="@dimen/ts_18" />

                <TextView
                    android:id="@+id/frg_history_detail_tv_total_tee"
                    style="@style/TCTextViewBlackBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/text_zero_tec"
                    android:textSize="@dimen/ts_18" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/frg_history_detail_rl_remain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fs_10">

                <TextView
                    style="@style/TCTextViewBlack1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/frg_history_detail_tv_remain"
                    android:gravity="center_vertical"
                    android:lines="1"
                    android:paddingEnd="@dimen/fs_10"
                    android:text="@string/text_remaining_payment"
                    android:textSize="@dimen/ts_18"
                    tools:ignore="RtlSymmetry" />

                <TextView
                    android:id="@+id/frg_history_detail_tv_remain"
                    style="@style/TCTextViewBlackBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="0.0 USD"
                    android:textSize="@dimen/ts_18" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/frg_history_detail_rl_payment_coin_back"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fs_10">

                <TextView
                    style="@style/TCTextViewBlack1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_coin_back"
                    android:textSize="@dimen/ts_18" />

                <TextView
                    android:id="@+id/frg_history_detail_tv_payment_coin_back"
                    style="@style/TCTextViewBlackBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/text_zero_tec"
                    android:textSize="@dimen/ts_18" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/frg_history_detail_rl_coin_back"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible">

                <TextView
                    style="@style/TCTextViewBlack1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="@string/coin_back_coinback"
                    android:textSize="@dimen/ts_18" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/frg_history_detail_tv_coin_back_amount"
                        style="@style/TCTextViewBlackBold"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/text_zero"
                        android:textSize="@dimen/ts_18" />

                    <TextView
                        style="@style/TCTextViewBlackBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/fs_5"
                        android:text="@string/tee_coin_symbol"
                        android:textSize="@dimen/ts_18" />
                </LinearLayout>
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/frg_history_detail_rl_reward"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="visible">

                <TextView
                    style="@style/TCTextViewBlack1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="@string/text_reward"
                    android:textSize="@dimen/ts_18" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/frg_history_detail_tv_reward"
                        style="@style/TCTextViewBlackBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_zero"
                        android:textSize="@dimen/ts_18" />

                    <TextView
                        style="@style/TCTextViewBlackBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/fs_5"
                        android:text="@string/tee_coin_symbol"
                        android:textSize="@dimen/ts_18" />
                </LinearLayout>
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/frg_history_detail_rl_transfer_money_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="visible">

                <TextView
                    style="@style/TCTextViewBlack1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="@string/general_amount"
                    android:textSize="@dimen/ts_18" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/frg_history_detail_tv_transfer_money_amount"
                        style="@style/TCTextViewBlackBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_zero"
                        android:textSize="@dimen/ts_18" />

                    <TextView
                        style="@style/TCTextViewBlackBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/fs_5"
                        android:text="@string/tee_coin_symbol"
                        android:textSize="@dimen/ts_18" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fs_20"
            android:layout_marginTop="@dimen/fs_30"
            android:visibility="gone"
            android:orientation="vertical">

            <include layout="@layout/view_review" />


        </LinearLayout>
    </LinearLayout>
</android.support.v4.widget.NestedScrollView>