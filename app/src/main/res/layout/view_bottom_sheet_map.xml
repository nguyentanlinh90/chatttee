<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_bottom_sheet_map"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:background="@android:color/white"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    app:behavior_hideable="true"
    app:behavior_peekHeight="@dimen/fs_40"
    app:layout_behavior="android.support.design.widget.BottomSheetBehavior">

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/c_d5d5d5" />

    <RelativeLayout
        android:id="@+id/view_bottom_sheet_map_rl_behavior_peek_height"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fs_40">

        <View
            android:id="@+id/view_bottom_sheet_map_v_hide_bottom_sheet"
            android:layout_width="@dimen/fs_55"
            android:layout_height="@dimen/fs_5"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_gray_solid_no_border_5_radius"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/view_bottom_sheet_map_v_show_bottom_sheet"
            android:layout_width="@dimen/fs_55"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:contentDescription="@string/todo"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_up_d5d5d5_24pt" />
    </RelativeLayout>

    <com.teecoin.ui.TCViewPager
        android:id="@+id/view_bottom_sheet_map_vp_vendor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fs_210" />

</LinearLayout>
