<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_f2f2f2"
    android:clickable="true"
    android:focusable="true">


    <com.emilsjolander.components.StickyScrollViewItems.StickyScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/frg_coupon_user_my_coupon_detail_view_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/fs_210"
                android:background="@color/c_e1e1e1">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/frg_coupon_user_my_coupon_detail_iv_banner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        tools:ignore="ContentDescription" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_coupon_image_banner" />
                </FrameLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fs_43"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="@dimen/fs_20"
                    android:layout_marginBottom="@dimen/fs_15"
                    android:orientation="horizontal">

                    <RelativeLayout
                        android:layout_width="@dimen/fs_45"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_square_transparent_solid_white_border_2dp">

                        <ImageView
                            android:id="@+id/frg_coupon_user_my_coupon_detail_iv_logo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="@dimen/fs_2"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_logo_chattee"
                            tools:ignore="ContentDescription" />
                    </RelativeLayout>


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/fs_10"
                            android:layout_marginEnd="@dimen/fs_3"
                            android:layout_toStartOf="@+id/frg_coupon_user_my_coupon_detail_ll_view"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/frg_coupon_user_my_coupon_detail_tv_name_vendor"
                                style="@style/TCTextViewWhiteBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textSize="@dimen/ts_18" />

                            <com.teecoin.ui.SimpleRatingBar
                                android:id="@+id/frg_coupon_user_my_coupon_detail_rating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:srb_borderColor="@color/c_b2973f"
                                app:srb_fillColor="@color/c_b2973f"
                                app:srb_numberOfStars="5"
                                app:srb_pressedBorderColor="@color/c_b2973f"
                                app:srb_pressedFillColor="@color/c_b2973f"
                                app:srb_rating="0"
                                app:srb_starSize="15dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/frg_coupon_user_my_coupon_detail_ll_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginEnd="@dimen/fs_15"
                            android:orientation="horizontal"
                            android:padding="@dimen/fs_2"
                            tools:ignore="UseCompoundDrawables">
                            <!-- android:background="@color/c_45000000"-->

                            <TextView
                                style="@style/TCTextViewWhite"
                                android:layout_marginEnd="@dimen/fs_1"
                                android:paddingBottom="@dimen/fs_0"
                                android:text="@string/coupons_view" />

                            <ImageView
                                android:layout_width="@dimen/fs_13"
                                android:layout_height="@dimen/fs_17"
                                android:layout_gravity="center_vertical"
                                android:rotation="180"
                                android:src="@drawable/ic_back_white_black_shadow"
                                tools:ignore="ContentDescription" />

                        </LinearLayout>
                    </RelativeLayout>
                </LinearLayout>

                <android.support.v7.widget.Toolbar
                    android:id="@+id/frg_coupon_user_my_coupon_detail_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?android:attr/actionBarSize"
                    android:layout_marginStart="-5dp"
                    android:layout_marginBottom="@dimen/fs_25"
                    android:visibility="visible"
                    app:contentInsetStartWithNavigation="0dp"
                    app:layout_collapseMode="pin"
                    app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />
                <!--app:navigationIcon="@drawable/ic_back_white_black_shadow"-->

            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/c_ffffff"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="@dimen/fs_15"
                android:paddingEnd="@dimen/fs_15"
                android:tag="sticky">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_coupon_gift"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/frg_coupon_user_my_coupon_detail_tv_name_coupon"
                    style="@style/TCTextViewBlackBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/text_three_dot" />

                <LinearLayout
                    android:id="@+id/frg_coupon_user_my_coupon_detail_view_tec"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/frg_coupon_user_my_coupon_detail_tv_tec"
                            style="@style/TCTextViewGoldBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_three_dot" />

                        <TextView
                            style="@style/TCTextViewBlack"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/fs_5"
                            android:text="@string/tee_coin_symbol" />

                        <TextView
                            android:id="@+id/frg_coupon_user_my_coupon_detail_tv_fee"
                            style="@style/TCTextViewBlack"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/fs_5"
                            android:text="" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/frg_coupon_user_my_coupon_detail_tv_end_at"
                            style="@style/TCTextViewBlack"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="" />
                    </LinearLayout>
                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/frg_coupon_user_my_coupon_detail_view_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/fs_10"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/icon"
                        android:layout_width="@dimen/fs_20"
                        android:layout_height="@dimen/fs_15"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/fs_5"
                        android:layout_marginTop="@dimen/fs_2"
                        android:src="@drawable/ic_location_gold"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/frg_coupon_user_my_coupon_detail_tv_address"
                        style="@style/TCTextViewBlack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/icon"
                        android:gravity="center_horizontal" />
                </RelativeLayout>
            </LinearLayout>

            <fragment
                android:id="@+id/frg_coupon_user_my_coupon_detail_map"
                android:name="com.google.android.gms.maps.SupportMapFragment"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fs_178" />

            <include
                layout="@layout/view_user_coupon_detail_time_start_end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_15"
                android:layout_marginTop="@dimen/fs_15"
                android:layout_marginEnd="@dimen/fs_15" />

            <RelativeLayout
                android:id="@+id/view_user_coupon_detail_rl_redemption_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_15"
                android:layout_marginTop="@dimen/fs_15"
                android:layout_marginEnd="@dimen/fs_15"
                android:background="@android:color/white"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/fs_10"
                    android:layout_height="@dimen/fs_20"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/todo"
                    android:src="@drawable/half_circle_gray_left" />

                <ImageView
                    android:layout_width="@dimen/fs_10"
                    android:layout_height="@dimen/fs_20"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/todo"
                    android:src="@drawable/half_circle_gray_right" />

                <TextView
                    android:id="@+id/tv_title_redemption_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fs_10"
                    android:gravity="center"
                    android:text="@string/redemption_date"
                    android:textColor="@color/c_9698a2"
                    android:textSize="@dimen/ts_13" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_title_redemption_date"
                    android:layout_marginTop="@dimen/fs_5"
                    android:layout_marginBottom="@dimen/fs_10"
                    android:gravity="center"
                    android:orientation="horizontal"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:layout_width="@dimen/fs_22"
                        android:layout_height="@dimen/fs_22"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/ic_watch_gold" />

                    <TextView
                        android:id="@+id/frg_coupon_user_my_coupon_detail_tv_redemption_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/fs_10"
                        android:gravity="center"
                        android:text="@string/text_text"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/ts_12_8" />
                </LinearLayout>
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/view_user_coupon_detail_ll_redemption_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fs_15"
                    android:layout_marginTop="@dimen/fs_15"
                    android:layout_marginEnd="@dimen/fs_15"
                    android:background="@color/c_ffffff"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TCTextViewGoldBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/fs_5"
                        android:paddingBottom="@dimen/fs_5"
                        android:text="@string/redemption_code"
                        android:textAllCaps="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fs_15"
                    android:layout_marginTop="@dimen/fs_2"
                    android:layout_marginEnd="@dimen/fs_15"
                    android:background="@color/c_ffffff"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/frg_coupon_user_my_coupon_detail_tv_redemption_code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/fs_10"
                        android:background="@color/c_f2f2f2"
                        android:gravity="center"
                        android:padding="@dimen/fs_8" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_15"
                android:layout_marginTop="@dimen/fs_15"
                android:layout_marginEnd="@dimen/fs_15"
                android:background="@color/c_ffffff"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    style="@style/TCTextViewGoldBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/fs_5"
                    android:paddingBottom="@dimen/fs_5"
                    android:text="@string/coupon_message_from_vendor" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_15"
                android:layout_marginTop="@dimen/fs_2"
                android:layout_marginEnd="@dimen/fs_15"
                android:background="@color/c_ffffff"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/frg_coupon_user_my_coupon_detail_tv_description"
                    style="@style/TCTextViewBlack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fs_5"
                    android:layout_marginEnd="@dimen/fs_5"
                    android:layout_marginBottom="@dimen/fs_10"
                    android:background="@color/c_f2f2f2"
                    android:padding="@dimen/fs_8" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_15"
                android:layout_marginTop="@dimen/fs_15"
                android:layout_marginEnd="@dimen/fs_15"
                android:background="@color/c_ffffff"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    style="@style/TCTextViewGoldBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/fs_5"
                    android:paddingBottom="@dimen/fs_5"
                    android:text="@string/terms_and_conditions"
                    android:textAllCaps="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_15"
                android:layout_marginTop="@dimen/fs_2"
                android:layout_marginEnd="@dimen/fs_15"
                android:background="@color/c_ffffff"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/frg_coupon_user_my_coupon_detail_tv_term"
                    style="@style/TCTextViewBlack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fs_5"
                    android:layout_marginEnd="@dimen/fs_5"
                    android:layout_marginBottom="@dimen/fs_10"
                    android:background="@color/c_f2f2f2"
                    android:padding="@dimen/fs_8" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_15"
                android:layout_marginTop="@dimen/fs_15"
                android:layout_marginEnd="@dimen/fs_15"
                android:background="@color/c_ffffff"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    style="@style/TCTextViewGoldBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/fs_5"
                    android:paddingBottom="@dimen/fs_5"
                    android:text="@string/coupon_simple_guide_to_redeem" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_15"
                android:layout_marginTop="@dimen/fs_2"
                android:layout_marginEnd="@dimen/fs_15"
                android:background="@color/c_ffffff"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/frg_coupon_user_my_coupon_detail_tv_guide"
                    style="@style/TCTextViewBlack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fs_5"
                    android:layout_marginEnd="@dimen/fs_5"
                    android:layout_marginBottom="@dimen/fs_10"
                    android:background="@color/c_f2f2f2"
                    android:padding="@dimen/fs_8"
                    android:text="@string/ask_cashier_when_check_out" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/frg_coupon_user_my_coupon_detail_ll_hashtags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_15"
                android:layout_marginTop="@dimen/fs_15"
                android:layout_marginEnd="@dimen/fs_15"
                android:layout_marginBottom="@dimen/fs_10"
                android:background="@color/c_ffffff"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/frg_coupon_user_my_coupon_detail_tv_hashtags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/fs_5" />
            </LinearLayout>

        </LinearLayout>
    </com.emilsjolander.components.StickyScrollViewItems.StickyScrollView>

    <LinearLayout
        android:id="@+id/frg_coupon_user_my_coupon_detail_view_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/frg_coupon_user_my_coupon_detail_tv_time_remain"
            style="@style/TCTextViewBlack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/fs_20"
            android:gravity="center"/>

        <TextView
            android:id="@+id/frg_coupon_user_my_coupon_detail_tv_purchase"
            style="@style/TCTextViewWhite"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/fs_40"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/fs_20"
            android:layout_marginBottom="@dimen/fs_20"
            android:background="@drawable/bg_gold_solid_no_border_30_radius"
            android:gravity="center"
            android:paddingStart="@dimen/fs_50"
            android:paddingEnd="@dimen/fs_50"
            android:text="@string/text_purchase"
            android:textAllCaps="true"
            android:textSize="@dimen/ts_12_8" />

        <TextView
            android:id="@+id/frg_coupon_user_my_coupon_detail_tv_get_coupon"
            style="@style/TCTextViewWhite"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/fs_40"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/fs_20"
            android:layout_marginBottom="@dimen/fs_20"
            android:background="@drawable/bg_gold_solid_no_border_30_radius"
            android:gravity="center"
            android:paddingStart="@dimen/fs_50"
            android:paddingEnd="@dimen/fs_50"
            android:text="@string/coupon_get_coupon"
            android:textAllCaps="true"
            android:textSize="@dimen/ts_12_8" />

        <TextView
            android:id="@+id/frg_coupon_user_my_coupon_detail_tv_scan_qr_code"
            style="@style/TCTextViewWhite"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/fs_40"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/fs_8"
            android:layout_marginTop="@dimen/fs_20"
            android:layout_marginBottom="@dimen/fs_20"
            android:background="@drawable/bg_gold_solid_no_border_30_radius"
            android:gravity="center"
            android:paddingStart="@dimen/fs_50"
            android:paddingEnd="@dimen/fs_50"
            android:text="@string/text_scan_qr_code"
            android:textSize="@dimen/ts_12" />
    </LinearLayout>

    <ImageView
        android:id="@+id/frg_coupon_user_my_coupon_detail_iv_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/fs_10"
        android:padding="@dimen/fs_2"
        android:src="@drawable/ic_back_white_black_shadow" />
</RelativeLayout>
