<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout style="@style/LinearLayoutVerticalParent">

        <include layout="@layout/view_shop_input_payment_profile" />

        <LinearLayout
            style="@style/view_group_discover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_10"
            android:orientation="vertical"
            android:paddingStart="@dimen/fs_0"
            tools:ignore="RtlSymmetry">

            <TextView
                style="@style/TCTextViewGrayBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_10"
                android:layout_marginTop="@dimen/fs_10"
                android:text="@string/total_bill"
                android:textSize="@dimen/ts_13" />

            <TextView
                android:id="@+id/frg_user_review_payment_tv_total_bill"
                style="@style/TCTextViewBlackBoldLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/fs_10"
                android:layout_marginStart="@dimen/fs_25"
                android:layout_marginTop="@dimen/fs_10"
                android:text="@string/text_zero" />

            <include layout="@layout/view_line" />

            <TextView
                style="@style/TCTextViewGrayBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_10"
                android:layout_marginTop="@dimen/fs_10"
                android:text="@string/amount_paid_by_wallet"
                android:textSize="@dimen/ts_13" />

            <LinearLayout
                style="@style/LinearLayoutHorizontalFullWidth"
                android:layout_marginTop="@dimen/fs_10">

                <TextView
                    android:id="@+id/frg_user_review_payment_tv_amount_wallet"
                    style="@style/TCTextViewGoldBoldLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fs_25"
                    android:text="@string/text_zero" />

                <TextView
                    style="@style/TCTextViewGoldBoldLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fs_30"
                    android:text="@string/tee_coin_symbol" />

                <TextView
                    style="@style/TCTextViewBlackBoldLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fs_30"
                    android:text="@string/text_character" />

                <TextView
                    android:id="@+id/frg_user_review_payment_tv_converd_to_tec"
                    style="@style/TCTextViewBlackBoldLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:layout_marginEnd="@dimen/fs_20"
                    android:layout_marginStart="@dimen/fs_20"
                    android:gravity="right"
                    android:text="@string/text_zero" />
            </LinearLayout>

            <TextView
                style="@style/TCTextViewGrayBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_10"
                android:layout_marginTop="@dimen/fs_10"
                android:text="@string/text_fee"
                android:textSize="@dimen/ts_13" />

            <LinearLayout
                style="@style/LinearLayoutHorizontalFullWidth"
                android:layout_marginTop="@dimen/fs_10">

                <TextView
                    android:id="@+id/frg_user_review_payment_tv_fee"
                    style="@style/TCTextViewGoldBoldLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fs_25"
                    android:text="@string/text_zero" />

                <TextView
                    style="@style/TCTextViewGoldBoldLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fs_30"
                    android:text="@string/tee_coin_symbol" />
            </LinearLayout>

            <TextView
                style="@style/TCTextViewGrayBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_10"
                android:layout_marginTop="@dimen/fs_10"
                android:text="@string/amount_paid_by_cash"
                android:textSize="@dimen/ts_13" />

            <TextView
                android:id="@+id/frg_user_review_payment_tv_amount_cash"
                style="@style/TCTextViewBlackBoldLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/fs_10"
                android:layout_marginStart="@dimen/fs_25"
                android:layout_marginTop="@dimen/fs_10"
                android:text="@string/text_zero" />

            <include layout="@layout/view_line" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/fs_10"
                android:layout_marginEnd="@dimen/fs_20"
                android:layout_marginStart="@dimen/fs_10"
                android:layout_marginTop="@dimen/fs_15">

                <TextView
                    style="@style/TCTextViewBlackLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_detail_amount"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/frg_shop_review_payment_tv_amount"
                    style="@style/TCTextViewGoldBoldLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/text_zero"
                    android:textAllCaps="true"
                    tools:ignore="RelativeOverlap" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/frg_user_review_payment_ll_coinback"
                style="@style/LinearLayoutVerticalFullWidth"
                android:layout_marginTop="@dimen/fs_5">

                <include layout="@layout/view_line" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/fs_15"
                    android:layout_marginEnd="@dimen/fs_20"
                    android:layout_marginStart="@dimen/fs_10"
                    android:layout_marginTop="@dimen/fs_15">

                    <TextView
                        style="@style/TCTextViewBlackLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_coin_back"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/frg_shop_review_payment_tv_coinback"
                        style="@style/TCTextViewGoldBoldLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="@string/text_zero"
                        android:textAllCaps="true"
                        tools:ignore="RelativeOverlap" />
                </RelativeLayout>

                <LinearLayout
                    style="@style/LinearLayoutHorizontalFullWidth"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/fs_15"
                    android:layout_marginStart="@dimen/fs_10"
                    android:gravity="center_vertical"
                    android:paddingBottom="@dimen/fs_5"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:layout_width="@dimen/fs_25"
                        android:layout_height="@dimen/fs_25"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/ic_notification_gold" />

                    <TextView
                        style="@style/TCTextViewGray"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/fs_7"
                        android:text="@string/user_payment_review_text_note" />
                </LinearLayout>
            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            style="@style/LinearLayoutHorizontalFullWidth"
            android:layout_marginBottom="@dimen/fs_10"
            android:layout_marginEnd="@dimen/fs_10"
            android:layout_marginStart="@dimen/fs_10">

            <include layout="@layout/view_cancel_next_bottom" />
        </LinearLayout>
    </LinearLayout>

</android.support.v4.widget.NestedScrollView>
