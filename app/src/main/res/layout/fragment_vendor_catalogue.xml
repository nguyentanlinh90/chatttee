<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:clickable="true"
    android:focusable="true">
    <include
        android:id="@+id/view_search"
        layout="@layout/view_search_all"
        />

    <android.support.design.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_search"
        android:layout_marginTop="-10dp"
        >

    <android.support.design.widget.AppBarLayout
        android:id="@+id/frg_coupon_user_catalogue_appbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="0dp"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <android.support.design.widget.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            app:collapsedTitleTextAppearance="@style/CollapsedTitle"
            app:expandedTitleTextAppearance="@style/ExpandedTitle"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:title="">
            <!--app:layout_scrollFlags="scroll|exitUntilCollapsed"-->

            <android.support.v7.widget.Toolbar
                android:layout_width="match_parent"
                android:layout_height="@dimen/fs_30"
                app:layout_collapseMode="pin" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >
                <TextView
                    android:id="@+id/fragment_discover_tv_title"
                    style="@style/TCTextViewGoldBold"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="@dimen/fs_15"
                    android:layout_marginTop="@dimen/fs_10"
                    android:text="@string/text_text"
                    tools:ignore="RtlSymmetry" />
                <include
                    layout="@layout/view_list_catalogue_image_horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fs_15"
                    android:layout_marginTop="@dimen/fs_10" />
            </LinearLayout>

            <RelativeLayout
                android:id="@+id/frg_coupon_user_catalogue_view_category_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom">

                <com.teecoin.ui.TCRecyclerView
                    android:id="@+id/frg_coupon_user_catalogue_rcv_category_name"
                    style="@style/recycler_view_item_main_user"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fs_15"
                    app:layoutManager="android.support.v7.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_coupon_category_name">

                </com.teecoin.ui.TCRecyclerView>

                <include
                    layout="@layout/view_line"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fs_0_5"
                    android:layout_alignParentBottom="true" />
            </RelativeLayout>
        </android.support.design.widget.CollapsingToolbarLayout>
    </android.support.design.widget.AppBarLayout>
        <android.support.v4.widget.NestedScrollView
            android:id="@+id/frag_discover_nested_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingBottom="@dimen/fs_88">

                <com.teecoin.ui.TCRecyclerView
                    android:id="@+id/frag_category_rcv_data"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/fs_4"
                    android:nestedScrollingEnabled="false"
                    android:orientation="vertical"
                    app:layoutManager="android.support.v7.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_review_main_single_category" />

                <include layout="@layout/view_no_data" />

            </LinearLayout>
        </android.support.v4.widget.NestedScrollView>
    </android.support.design.widget.CoordinatorLayout>



    <!--<RelativeLayout
        android:id="@+id/fragment_vendor_catalogue_v_suggest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/view_search"
        android:layout_marginStart="@dimen/fs_10"
        android:layout_marginEnd="@dimen/fs_10"
        android:background="@drawable/my_shadow_radius_4pt"
        android:elevation="@dimen/fs_2">-->

        <com.teecoin.ui.TCRecyclerView
            android:layout_below="@+id/view_search"
            android:layout_marginStart="@dimen/fs_10"
            android:layout_marginEnd="@dimen/fs_10"
            android:background="@drawable/my_shadow_radius_4pt"
            android:elevation="@dimen/fs_2"
            android:id="@+id/fragment_vendor_catalogue_rcv_suggest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layoutManager="android.support.v7.widget.LinearLayoutManager"
            tools:listitem="@layout/item_suggest" />
    <!--</RelativeLayout>-->
    <!--<include layout="@layout/view_back_to_top" />-->

    <include layout="@layout/view_floating_action_button" />

</RelativeLayout>
