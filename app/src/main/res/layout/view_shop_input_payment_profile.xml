<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/view_group_discover"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/fs_15"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="@dimen/fs_7"
    android:paddingTop="@dimen/fs_7">

    <RelativeLayout
        android:layout_width="@dimen/fs_62"
        android:layout_height="@dimen/fs_62"
        android:layout_gravity="center_vertical"
        android:background="@drawable/bg_oval_white_solid_gold_border">

        <ImageView
            android:id="@+id/frg_shop_input_payment_iv_avatar"
            android:layout_width="@dimen/fs_59"
            android:layout_height="@dimen/fs_59"
            android:layout_centerInParent="true"
            android:contentDescription="@string/todo"
            android:scaleType="centerCrop" />

    </RelativeLayout>

    <LinearLayout
        style="@style/LinearLayoutVerticalFullWidth"
        android:layout_marginStart="@dimen/fs_15">

        <LinearLayout
            style="@style/LinearLayoutHorizontalFullWidth"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:contentDescription="@string/todo"
                android:src="@drawable/ic_profile_payment" />

            <TextView
                android:id="@+id/frg_shop_input_payment_tv_name"
                style="@style/TCTextViewGold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_5"
                android:gravity="center_vertical"
                android:text="@string/text_text"
                android:textAllCaps="true" />
        </LinearLayout>

        <LinearLayout
            style="@style/LinearLayoutHorizontalFullWidth"
            android:layout_marginTop="@dimen/fs_5"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/fs_15"
                android:contentDescription="@string/todo"
                android:src="@drawable/ic_location_gold_border" />

            <TextView
                android:id="@+id/frg_shop_input_payment_tv_address"
                style="@style/TCTextViewBlack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_8"
                android:gravity="center_vertical"
                android:text="@string/text_text" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
