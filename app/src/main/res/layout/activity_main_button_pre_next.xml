<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_main_ll_next_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="@dimen/fs_5">

    <ImageView
        android:id="@+id/activity_main_iv_back"
        android:layout_width="@dimen/fs_67"
        android:layout_height="@dimen/fs_67"
        android:layout_marginEnd="@dimen/fs_20"
        android:contentDescription="@string/todo"
        android:src="@drawable/ic_back_grey" />

    <ImageView
        android:id="@+id/activity_main_iv_next"
        android:layout_width="@dimen/fs_67"
        android:layout_height="@dimen/fs_67"
        android:layout_marginStart="@dimen/fs_20"
        android:contentDescription="@string/todo"
        android:src="@drawable/ic_next_gold" />

    <ImageView
        android:id="@+id/activity_main_iv_done"
        android:layout_width="@dimen/fs_67"
        android:layout_height="@dimen/fs_67"
        android:layout_marginStart="@dimen/fs_20"
        android:contentDescription="@string/todo"
        android:src="@drawable/ic_done_gold"
        android:visibility="gone" />
</LinearLayout>
