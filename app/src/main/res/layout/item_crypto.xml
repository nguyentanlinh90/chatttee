<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_below="@+id/tv_notice"
    android:layout_marginStart="@dimen/fs_5"
    android:layout_marginTop="@dimen/fs_5"
    android:layout_marginEnd="@dimen/fs_5"
    android:layout_marginBottom="@dimen/fs_10"
    android:elevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/item_crypto_iv_icon"
            android:layout_width="@dimen/fs_25"
            android:layout_height="@dimen/fs_25"
            android:layout_marginStart="@dimen/fs_11"
            android:layout_marginEnd="@dimen/fs_11" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/fs_10"
            android:paddingEnd="@dimen/fs_5"
            android:paddingBottom="@dimen/fs_10">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/fs_10">

                <TextView
                    android:id="@+id/item_crypto_tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/view_right"
                    android:fontFamily="@font/axis_std_bold"
                    android:text="@string/text_three_dot"
                    android:textColor="@color/c_2d2d2d"
                    android:textSize="@dimen/ts_14" />

                <LinearLayout
                    android:id="@+id/view_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/item_crypto_tv_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/fs_20"
                        android:fontFamily="@font/axis_std_regular"
                        android:text="@string/text_three_dot"
                        android:textColor="@color/c_b21225"
                        android:textSize="@dimen/ts_14"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/frg_top_up_tv_exchange_rate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/axis_std_regular"
                        android:gravity="end"
                        android:text="@string/text_three_dot"
                        android:textAllCaps="true"
                        android:textColor="@color/c_b2973f"
                        android:textSize="@dimen/ts_12" />
                </LinearLayout>


            </RelativeLayout>

            <TextView
                android:id="@+id/frg_top_up_tv_show_wallet"
                style="@style/TCViewWallet"
                android:layout_marginTop="@dimen/fs_10" />

            <RelativeLayout
                android:id="@+id/frg_top_up_rl_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <TextView
                    android:id="@+id/frg_top_up_tv_address_wallet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/fs_10"
                    android:layout_toStartOf="@+id/frg_top_up_ll_button"
                    android:fontFamily="@font/axis_std_regular"
                    android:text="@string/text_text"
                    android:textColor="@color/c_9b9b9b"
                    android:textSize="@dimen/ts_12" />

                <LinearLayout
                    android:id="@+id/frg_top_up_ll_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/fragment_top_up_iv_qr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/fs_5"
                        android:src="@drawable/ic_qr_code" />

                    <ImageView
                        android:id="@+id/fragment_top_up_iv_copy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/fs_10"
                        android:layout_marginEnd="@dimen/fs_10"
                        android:padding="@dimen/fs_5"
                        android:src="@drawable/ic_refer_copy" />

                    <ImageView
                        android:id="@+id/fragment_top_up_iv_share"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/fs_5"
                        android:src="@drawable/ic_refer_sharing" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</android.support.v7.widget.CardView>
