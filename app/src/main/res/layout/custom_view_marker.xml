<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/custom_view_marker_tv_title"
        style="@style/TCTextViewBlackBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:gravity="center_horizontal"
        android:maxWidth="@dimen/fs_100"
        android:textSize="@dimen/ts_9" />

    <RelativeLayout
        android:layout_width="@dimen/fs_42"
        android:layout_height="wrap_content"
        android:layout_below="@+id/custom_view_marker_tv_title"
        android:layout_centerHorizontal="true">

        <ImageView
            android:id="@+id/custom_view_marker_iv_marker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/fs_5"
            android:layout_marginStart="@dimen/fs_5"
            android:adjustViewBounds="true"
            android:contentDescription="@string/todo"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_marker_default" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/view_marker_iv_marker_coupon"
                android:layout_width="@dimen/fs_15"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fs_2"
                android:adjustViewBounds="true"
                android:contentDescription="@string/todo"
                android:scaleType="fitXY"
                android:src="@drawable/ic_marker_coupon"
                tools:ignore="RtlSymmetry" />

            <ImageView
                android:id="@+id/view_marker_iv_marker_cash"
                android:layout_width="@dimen/fs_15"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fs_3"
                android:adjustViewBounds="true"
                android:contentDescription="@string/todo"
                android:scaleType="fitXY"
                android:src="@drawable/ic_marker_cash" />
        </LinearLayout>


    </RelativeLayout>
</RelativeLayout>