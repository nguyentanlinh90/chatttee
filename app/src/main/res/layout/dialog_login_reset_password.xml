<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginEnd="@dimen/fs_31"
        android:layout_marginStart="@dimen/fs_31"
        android:background="@drawable/bg_white_solid_no_border_5_radius"
        android:orientation="vertical"
        android:padding="@dimen/fs_21">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/fs_31"
            android:layout_marginTop="@dimen/fs_10"
            style="@style/TCTextViewGoldBold"
            android:text="@string/password_reset_sent"
            android:textAllCaps="true"
            android:textSize="@dimen/ts_16" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TCTextViewBlack"
            android:gravity="center_horizontal"
            android:lineSpacingExtra="@dimen/fs_5"
            android:text="@string/an_email_with_password_reset_instructions_has_been_sent_to_your_registered_email_address"
            android:textSize="@dimen/ts_12" />

        <TextView
            android:id="@+id/dialog_login_reset_password_tv_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_10"
            style="@style/TCTextViewBlackBold"
            android:gravity="center_horizontal"
            android:lineSpacingExtra="@dimen/fs_5"
            android:textSize="@dimen/ts_12" />

        <include
            layout="@layout/button_ok"
            android:layout_width="@dimen/fs_150"
            android:layout_height="@dimen/fs_39"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/fs_66" />
    </LinearLayout>
</RelativeLayout>
