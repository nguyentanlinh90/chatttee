<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fs_4"
        android:layout_marginTop="@dimen/fs_17"
        android:layout_marginEnd="@dimen/fs_4"
        android:background="@drawable/bg_white_solid_gray_border_5_radius"
        android:orientation="vertical"
        android:padding="@dimen/fs_10">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fs_10"
            style="@style/TCTextViewBlackBold"
            android:text="@string/text_secret_key"
            android:textSize="@dimen/ts_12" />

        <TextView
            android:id="@+id/fragment_secret_key_tv_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fs_10"
            style="@style/TCTextViewBlack"
            android:lineSpacingExtra="@dimen/fs_5"
            android:textAllCaps="true"
            android:textSize="@dimen/ts_12" />


        <include
            layout="@layout/button_left"
            android:layout_width="@dimen/fs_210"
            android:layout_height="@dimen/fs_39"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/fs_5"
            android:layout_marginBottom="@dimen/fs_15" />

    </LinearLayout>

</LinearLayout>
