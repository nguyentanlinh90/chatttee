<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:clickable="true"
    android:focusable="true">

    <android.support.v4.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/view_review"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <include layout="@layout/view_coupon_result_processing" />

            <include layout="@layout/view_coupon_header_checkin_success" />

            <include layout="@layout/view_coupon_user_result_view_more_bottom" />
        </LinearLayout>
    </android.support.v4.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/view_review"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/fs_45"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/fs_10"
        android:layout_marginTop="@dimen/fs_10"
        android:background="@drawable/bg_white_solid_gray_border_30_radius"
        android:orientation="horizontal"
        android:paddingEnd="@dimen/fs_50"
        android:paddingStart="@dimen/fs_50">

        <ImageView
            android:layout_width="@dimen/fs_30"
            android:layout_height="@dimen/fs_25"
            android:layout_gravity="center"
            android:src="@drawable/ic_review_gray_start" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/fs_10"
            android:gravity="center"
            android:text="@string/text_review"
            android:textAllCaps="true" />
    </LinearLayout>

</RelativeLayout>



