<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout style="@style/LinearLayoutVerticalParent">

        <include layout="@layout/view_shop_input_payment_profile" />

        <LinearLayout
            style="@style/view_group_discover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_10"
            android:orientation="vertical"
            android:paddingStart="@dimen/fs_0"
            tools:ignore="RtlSymmetry">

            <TextView
                style="@style/TCTextViewGrayBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_10"
                android:layout_marginTop="@dimen/fs_10"
                android:text="@string/total_bill"
                android:textSize="@dimen/ts_13" />

            <TextView
                android:id="@+id/frg_shop_review_payment_tv_total_bill"
                style="@style/TCTextViewBlackBoldLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/fs_10"
                android:layout_marginStart="@dimen/fs_25"
                android:layout_marginTop="@dimen/fs_10"
                android:text="@string/text_zero" />

            <include layout="@layout/view_line" />

            <TextView
                style="@style/TCTextViewGrayBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_10"
                android:layout_marginTop="@dimen/fs_15"
                android:text="@string/amount_to_be_by_wallet"
                android:textSize="@dimen/ts_13" />

            <LinearLayout
                style="@style/LinearLayoutHorizontalFullWidth"
                android:layout_marginTop="@dimen/fs_10">

                <TextView
                    android:id="@+id/frg_shop_review_payment_tv_amount_wallet"
                    style="@style/TCTextViewBlackBoldLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fs_25"
                    android:text="@string/text_zero" />

                <TextView
                    style="@style/TCTextViewBlackBoldLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/fs_20"
                    android:layout_marginStart="@dimen/fs_20"
                    android:text="@string/text_character" />

                <TextView
                    android:id="@+id/frg_shop_review_payment_tv_converd_to_tec"
                    style="@style/TCTextViewGoldBoldLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/fs_10"
                    android:gravity="end"
                    android:text="@string/text_zero" />
            </LinearLayout>

            <TextView
                style="@style/TCTextViewGrayBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_10"
                android:layout_marginTop="@dimen/fs_15"
                android:text="@string/amount_to_be_by_cash"
                android:textSize="@dimen/ts_13" />

            <TextView
                android:id="@+id/frg_shop_review_payment_tv_amount_cash"
                style="@style/TCTextViewBlackBoldLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/fs_10"
                android:layout_marginStart="@dimen/fs_25"
                android:layout_marginTop="@dimen/fs_10"
                android:text="@string/text_zero" />
        </LinearLayout>

        <LinearLayout
            style="@style/LinearLayoutHorizontalFullWidth"
            android:layout_margin="@dimen/fs_10">

            <include layout="@layout/view_cancel_next_bottom" />
        </LinearLayout>
    </LinearLayout>


</android.support.v4.widget.NestedScrollView>
