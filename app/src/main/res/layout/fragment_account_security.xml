<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingTop="@dimen/fs_20">

    <RelativeLayout
        android:id="@+id/frg_account_security_rl_secret_key"
        style="@style/fragment_account_view_item">

        <ImageView
            android:id="@+id/frg_account_security_iv_secret_key"
            style="@style/fragment_account_iv_icon_item"
            android:src="@drawable/ic_account_secret_key_backup"
            tools:ignore="ContentDescription" />

        <TextView
            style="@style/fragment_account_tv_title_item"
            android:layout_toEndOf="@+id/frg_account_security_iv_secret_key"
            android:text="@string/text_secret_key"
            tools:ignore="RelativeOverlap" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/frg_account_security_rl_change_password"
        style="@style/fragment_account_view_item">

        <ImageView
            android:id="@+id/frg_account_security_iv_change_password"
            style="@style/fragment_account_iv_icon_item"
            android:src="@drawable/ic_account_password"
            tools:ignore="ContentDescription" />

        <TextView
            style="@style/fragment_account_tv_title_item"
            android:layout_toEndOf="@+id/frg_account_security_iv_change_password"
            android:text="@string/change_password"
            tools:ignore="RelativeOverlap" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/frg_account_security_rl_forgot_password"
        style="@style/fragment_account_view_item">

        <ImageView
            android:id="@+id/frg_account_security_iv_forgot_password"
            style="@style/fragment_account_iv_icon_item"
            android:src="@drawable/ic_account_password"
            tools:ignore="ContentDescription" />

        <TextView
            style="@style/fragment_account_tv_title_item"
            android:layout_toEndOf="@+id/frg_account_security_iv_forgot_password"
            android:text="@string/account_forgot_password"
            tools:ignore="RelativeOverlap" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/frg_account_security_rl_payment_threshold"
        style="@style/fragment_account_view_item">

        <ImageView
            android:id="@+id/frg_account_security_iv_payment_threshold"
            style="@style/fragment_account_iv_icon_item"
            android:src="@drawable/ic_account_payment_threshold"
            tools:ignore="ContentDescription" />

        <TextView
            style="@style/fragment_account_tv_title_item"
            android:layout_toEndOf="@+id/frg_account_security_iv_payment_threshold"
            android:text="@string/text_payment_threshold"
            tools:ignore="RelativeOverlap" />
    </RelativeLayout>

</LinearLayout>
