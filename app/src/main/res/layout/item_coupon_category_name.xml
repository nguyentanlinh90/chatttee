<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingEnd="@dimen/fs_8"
    tools:ignore="RtlSymmetry">
    <TextView
        android:id="@+id/item_coupon_category_name_tv_name"
        android:layout_margin="@dimen/fs_5"
        android:ellipsize="end"
        style="@style/TCTextViewGold"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/text_text"
        android:textStyle="bold"
        android:textColor="@drawable/categories_text_selector"
        android:textSize="@dimen/ts_12" />

</LinearLayout>
