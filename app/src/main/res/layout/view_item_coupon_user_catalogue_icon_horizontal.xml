<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/fs_90"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/view_item_coupon_user_catalogue_icon_horizontal_rl_background"
        android:layout_width="@dimen/fs_50"
        android:layout_height="@dimen/fs_50"
        android:layout_gravity="center"
        android:background="@drawable/bg_circle_gray"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/view_item_coupon_user_catalogue_icon_horizontal_iv_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="@string/todo"
            android:src="@drawable/ic_logo_chattee" />

    </RelativeLayout>

    <TextView
        android:id="@+id/view_item_coupon_user_catalogue_icon_horizontal_tv_name"
        style="@style/TCTextViewBlack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fs_5"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/text_text"
        android:textSize="@dimen/ts_11" />

</LinearLayout>
