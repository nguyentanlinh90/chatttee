<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:clickable="true"
    android:fillViewport="true"
    android:id="@+id/frg_write_review_view_parent"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            style="@style/LinearLayoutHorizontalFullWidth"
            android:layout_marginStart="@dimen/fs_17"
            android:layout_marginTop="@dimen/fs_17"
            android:layout_marginBottom="@dimen/fs_17"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            tools:ignore="UseCompoundDrawables">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_notice_circle"
                android:contentDescription="@string/todo" />

            <TextView
               style="@style/TCTextViewGold"
                android:text="@string/write_review_title_header"
                android:layout_marginStart="@dimen/fs_10"

                />

        </LinearLayout>

        <include layout="@layout/view_line"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/c_b2973f"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/fs_30"
            android:paddingTop="@dimen/fs_15"
            android:paddingRight="@dimen/fs_30"
            android:paddingBottom="@dimen/fs_15"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/fs_35"
                android:layout_height="@dimen/fs_35"
                android:contentDescription="@string/todo"
                android:src="@drawable/ic_coin_white_test" />

            <TextView
                android:id="@+id/frg_write_review_tv_coin_receive"
                style="@style/TCTextViewWhite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_10"
                android:gravity="center_vertical"
                android:text="@string/user_review_text_receive" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/fs_10"
            tools:ignore="RtlSymmetry">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/fs_17"
                style="@style/TCTextViewBlack"
                android:text="@string/write_review_tap_a_star_to_rate"
                android:textSize="@dimen/ts_16" />

            <!--<com.teecoin.ui.SimpleRatingBar-->
                <!--android:id="@+id/frag_user_review_rating"-->
                <!--android:layout_width="match_parent"-->
                <!--android:layout_height="@dimen/fs_60"-->
                <!--android:layout_marginStart="@dimen/fs_58"-->
                <!--android:layout_marginEnd="@dimen/fs_58"-->
                <!--app:srb_borderColor="@color/c_b2973f"-->
                <!--app:srb_fillColor="@color/c_b2973f"-->
                <!--app:srb_numberOfStars="5"-->
                <!--app:srb_stepSize="1" />-->

            <RatingBar
                android:id="@+id/frag_user_review_rating"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/fs_34"
                android:progressDrawable="@drawable/bg_rating_star_write_review"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/fs_17"
                android:layout_marginBottom="@dimen/fs_18"
                 android:numStars="5"
                android:stepSize="1"
                />
            <!--android:scaleX="0.8"
                android:scaleY="0.8"-->

            <include layout="@layout/view_line" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_17"
                android:layout_marginTop="@dimen/fs_17"
                android:layout_marginBottom="@dimen/fs_17"
                style="@style/TCTextViewBlackBold"
                android:text="@string/write_review_date_visited"
                android:textSize="@dimen/ts_14" />

            <RelativeLayout
                android:id="@+id/frg_user_review_shop_ll_date_visited"
                android:layout_width="@dimen/fs_225"
                android:layout_height="@dimen/fs_34"
                android:layout_marginStart="@dimen/fs_17"
                android:background="@drawable/bg_transparent_solid_gray_border_5_radius">

                <TextView
                    android:id="@+id/frg_user_review_shop_tv_date_visited"
                    style="@style/TCTextViewGray"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:layout_toStartOf="@+id/view_select_time_start_iv_arrow"
                    android:gravity="center"
                    android:hint="2018/01/20"
                    android:textColorHint="@color/c_8e8e93"
                    android:textSize="@dimen/ts_12" />

                <ImageView
                    android:id="@+id/view_select_time_start_iv_arrow"
                    style="@style/style_arrow_up"
                    android:layout_alignParentEnd="true"
                    android:contentDescription="@string/todo" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_17"
                android:layout_marginTop="@dimen/fs_17"
                android:layout_marginBottom="@dimen/fs_17"
                style="@style/TCTextViewBlackBold"
                android:text="@string/write_review_type_of_visit"
                android:textSize="@dimen/ts_14" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_17"
                android:layout_marginEnd="@dimen/fs_17"
                android:orientation="horizontal">

                <com.nex3z.flowlayout.FlowLayout
                    android:id="@+id/frg_user_review_shop_fl_visit_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:flRowSpacing="8dp">

                </com.nex3z.flowlayout.FlowLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_17"
                style="@style/TCTextViewBlackBold"
                android:text="@string/write_review_review_title"
                android:textSize="@dimen/ts_14" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/fs_46"
                android:layout_marginStart="@dimen/fs_17"
                android:layout_marginTop="@dimen/fs_16"
                android:layout_marginEnd="@dimen/fs_17"
                android:background="@drawable/bg_white_solid_gray_border_5_radius">

                <EditText
                    android:id="@+id/frg_user_review_shop_et_title"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:ellipsize="end"
                    style="@style/TCTextViewBlack"
                    android:gravity="center_vertical"
                    android:hint="@string/write_review_please_enter_review_title"
                    android:lines="1"
                    android:paddingStart="@dimen/fs_5"
                    android:paddingEnd="@dimen/fs_5"
                    android:textColorHint="@color/c_9b9b9b"
                    android:textSize="@dimen/ts_13" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ts_17"
                android:layout_marginTop="@dimen/ts_17"
                android:layout_marginEnd="@dimen/ts_17"
                android:layout_marginBottom="@dimen/ts_17"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/frg_user_review_shop_tv_your_review"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    style="@style/TCTextViewBlackBold"
                    android:text="@string/write_review_your_review"
                    android:textSize="@dimen/ts_14" />

                <TextView
                    style="@style/TCTextViewDefault"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/frg_user_review_shop_tv_your_review"
                    android:text=" *"
                    android:textColor="@color/c_e01e1e" />

                <TextView
                    android:id="@+id/frg_user_review_shop_tv_minimum_50"
                    style="@style/TCTextViewBlack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/text_50_minimum" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_17"
                android:layout_marginEnd="@dimen/fs_17"
                android:background="@drawable/bg_white_solid_gray_border_5_radius"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/frag_user_et_comment"
                    style="@style/TCEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:imeOptions="actionDone"
                    android:inputType="textMultiLine"
                    android:lines="4"
                    android:padding="@dimen/fs_5" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_17"
                android:layout_marginTop="@dimen/fs_17"
                android:layout_marginBottom="@dimen/fs_17"
                style="@style/TCTextViewBlackBold"
                android:text="@string/select_image_from_photo"
                android:textSize="@dimen/ts_14" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_17"
                android:layout_marginEnd="@dimen/fs_17"
                style="@style/TCTextViewGold"
                android:text="@string/get_more_tec_rewards_when_you_attach_pictures"
                android:textSize="@dimen/ts_12" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/fs_80"
                android:layout_marginStart="@dimen/fs_15"
                android:layout_marginTop="@dimen/fs_17"
                android:layout_marginEnd="@dimen/fs_15"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/frag_user_review_ll_add_photo"
                    android:layout_width="@dimen/fs_80"
                    android:layout_height="@dimen/fs_70"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_white_solid_gray_border_5_radius"
                    android:gravity="center"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_circle_gray"
                        android:padding="@dimen/fs_8">

                        <ImageView
                            android:layout_width="@dimen/fs_30"
                            android:layout_height="@dimen/fs_30"
                            android:contentDescription="@string/text_parameter_with_tec"
                            android:src="@drawable/ic_camera_gray_bold" />
                    </RelativeLayout>
                </LinearLayout>

                <com.teecoin.ui.TCRecyclerView
                    android:id="@+id/frag_user_review_rcv_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/fs_15"
                    android:scrollbars="none"
                    tools:listitem="@layout/item_add_image_horizontion" />

            </LinearLayout>

            <TextView
                style="@style/TCTextViewBlackBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_17"
                android:layout_marginTop="@dimen/fs_17"
                android:layout_marginBottom="@dimen/fs_17"
                android:text="@string/user_review_share_now"
                android:textSize="@dimen/ts_14"
                android:visibility="gone" />

            <!--<include layout="@layout/view_share_social" />-->
        </LinearLayout>


        <include layout="@layout/view_line" />

        <include
            layout="@layout/button_ok"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fs_36"
            android:layout_marginStart="@dimen/fs_85"
            android:layout_marginTop="@dimen/fs_17"
            android:layout_marginEnd="@dimen/fs_85"
            android:layout_marginBottom="@dimen/fs_17" />

    </LinearLayout>
</android.support.v4.widget.NestedScrollView>
