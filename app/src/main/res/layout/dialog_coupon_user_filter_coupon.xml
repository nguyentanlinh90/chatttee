<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/fs_10"
    tools:ignore="MissingDefaultResource">

    <android.support.v4.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/dialog_coupon_user_filter_coupon_v_indicator"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_10"
            android:orientation="vertical"
            android:paddingBottom="@dimen/fs_20">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    style="@style/style_coupon_view_search"
                    android:layout_toStartOf="@+id/dialog_coupon_user_filter_coupon_tv_reset_all"
                    tools:ignore="UselessParent">

                    <ImageView
                        style="@style/style_coupon_bt_search"
                        android:contentDescription="@string/todo" />

                    <EditText
                        android:id="@+id/dialog_coupon_user_filter_coupon_et_search"
                        style="@style/style_coupon_et_search"
                        android:importantForAutofill="no"
                        tools:ignore="LabelFor,UnusedAttribute" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dialog_coupon_user_filter_coupon_tv_reset_all"
                    style="@style/tv_reset_all" />

            </RelativeLayout>

            <TextView
                style="@style/fragment_coupon_shop_tv_title"
                android:text="@string/text_sort_by"
                android:textAllCaps="true" />

            <CheckBox
                android:id="@+id/dialog_coupon_user_filter_coupon_cb_ending_soon"
                style="@style/style_filter_coupon_cb_oval_vertical"
                android:layout_marginTop="@dimen/fs_20"
                android:layout_marginBottom="@dimen/fs_20"
                android:text="@string/ending_soon" />

            <CheckBox
                android:id="@+id/dialog_coupon_user_filter_coupon_cb_latest"
                style="@style/style_filter_coupon_cb_oval_vertical"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/fs_20"
                android:text="@string/text_latest" />

            <TextView
                style="@style/fragment_coupon_shop_tv_title"
                android:text="@string/text_discount"
                android:textAllCaps="true" />

            <CheckBox
                android:id="@+id/dialog_coupon_user_filter_coupon_cb_buy_one_get_one"
                style="@style/style_filter_coupon_cb_square_vertical"
                android:layout_marginTop="@dimen/fs_20"
                android:text="@string/buy_1_get_1" />

            <CheckBox
                android:id="@+id/dialog_coupon_user_filter_coupon_cb_free_gift"
                style="@style/style_filter_coupon_cb_square_vertical"
                android:text="@string/free_gift" />

            <CheckBox
                android:id="@+id/dialog_coupon_user_filter_coupon_cb_discount_percent"
                style="@style/style_filter_coupon_cb_square_vertical"
                android:text="@string/discount_percentage_symbol" />

            <FrameLayout
                android:id="@+id/dialog_coupon_user_filter_coupon_sb_discount_percent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/fs_40"
                android:paddingEnd="@dimen/fs_40"
                android:paddingBottom="@dimen/fs_10"
                android:visibility="gone" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <CheckBox
                    android:id="@+id/dialog_coupon_user_filter_coupon_cb_cash"
                    style="@style/style_filter_coupon_cb_square_vertical"
                    android:text="@string/cash_value" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:text="@string/change_currency"
                    android:textColor="@color/c_a6a8b0"
                    android:textSize="@dimen/ts_12"
                    android:visibility="gone"
                    tools:ignore="RelativeOverlap,RtlHardcoded" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/dialog_coupon_user_filter_coupon_v_cash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_20"
                android:layout_marginEnd="@dimen/fs_20"
                android:layout_marginBottom="@dimen/fs_20"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/dialog_coupon_user_filter_coupon_et_min_cash"
                    android:layout_width="@dimen/fs_105"
                    android:layout_height="@dimen/fs_35"
                    android:background="@drawable/bg_transparent_solid_gray_border_5_radius"
                    android:gravity="center"
                    android:hint="@string/min"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:textColor="@color/c_b2973f"
                    android:textCursorDrawable="@null"
                    tools:ignore="LabelFor"
                    tools:targetApi="o" />

                <TextView
                    style="@style/TCTextViewGray"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/fs_10"
                    android:layout_marginEnd="@dimen/fs_10"
                    android:text="〜"
                    android:textSize="@dimen/ts_20" />

                <EditText
                    android:id="@+id/dialog_coupon_user_filter_coupon_et_max_cash"
                    android:layout_width="@dimen/fs_105"
                    android:layout_height="@dimen/fs_35"
                    android:background="@drawable/bg_transparent_solid_gray_border_5_radius"
                    android:gravity="center"
                    android:hint="@string/max"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:textColor="@color/c_b2973f"
                    android:textCursorDrawable="@null"
                    tools:ignore="LabelFor"
                    tools:targetApi="o" />
            </LinearLayout>

            <TextView
                style="@style/fragment_coupon_shop_tv_title"
                android:layout_marginTop="@dimen/fs_10"
                android:text="@string/day_remains" />

            <EditText
                android:id="@+id/dialog_coupon_user_filter_coupon_et_day_remain"
                android:layout_width="@dimen/fs_105"
                android:layout_height="@dimen/fs_35"
                android:layout_margin="@dimen/fs_20"
                android:background="@drawable/bg_transparent_solid_gray_border_5_radius"
                android:gravity="center"
                android:hint="0"
                android:importantForAutofill="no"
                android:inputType="number"
                android:paddingLeft="@dimen/fs_5"
                android:paddingRight="@dimen/fs_5"
                android:textColor="@color/c_b2973f"
                android:textCursorDrawable="@null"
                android:textStyle="bold"
                tools:ignore="LabelFor"
                tools:targetApi="o" />

            <TextView
                style="@style/fragment_coupon_shop_tv_title"
                android:text="@string/coupon_validity" />

            <include layout="@layout/view_select_time_start" />

            <include layout="@layout/view_select_time_end" />

        </LinearLayout>
    </android.support.v4.widget.NestedScrollView>

    <View
        android:id="@+id/dialog_coupon_user_filter_coupon_v_indicator"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fs_3"
        android:layout_above="@+id/dialog_coupon_user_filter_coupon_tv_bt_done"
        android:layout_marginBottom="@dimen/fs_10"
        android:background="@drawable/bg_line_shadow" />

    <TextView
        android:id="@+id/dialog_coupon_user_filter_coupon_tv_bt_done"
        android:layout_width="@dimen/fs_147"
        android:layout_height="@dimen/fs_40"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:background="@drawable/bg_gold_solid_no_border_30_radius"
        android:gravity="center"
        android:text="@string/text_done"
        android:textAllCaps="true"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_14" />
</RelativeLayout>