<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:clickable="true"
    android:fillViewport="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="@dimen/fs_15">

        <include layout="@layout/ripplelayout_success" />

        <include layout="@layout/ripplelayout_fail" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fs_20"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/frg_transaction_tv_success"
                style="@style/TCTextViewGoldBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_successfully"
                android:textAllCaps="true"
                android:textSize="@dimen/ts_20" />

            <TextView
                style="@style/TCTextViewBlack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/transaction_success_you_can_track"
                android:visibility="gone" />

            <TextView
                android:id="@+id/frg_transaction_tv_error_message"
                style="@style/TCTextViewBlackBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_10"
                android:layout_marginTop="@dimen/fs_10"
                android:layout_marginEnd="@dimen/fs_10"
                android:gravity="center_horizontal"
                android:text="" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/frg_send_money_result_ll_detail"
            style="@style/view_item_main_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="@dimen/fs_2"
            android:orientation="vertical"
            android:padding="@dimen/fs_20">

            <LinearLayout
                android:id="@+id/frg_transaction_result_ll_transfer_money_account_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fs_10"
                android:orientation="horizontal"
                android:weightSum="3">

                <TextView
                    style="@style/TCTextViewBlack"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/text_payee" />

                <TextView
                    android:id="@+id/frg_transaction_result_tv_transfer_money_account_name"
                    style="@style/TCTextViewBlackBold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="abc" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/frg_transaction_result_ll_transfer_money_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fs_10"
                android:orientation="horizontal"
                android:weightSum="3">

                <TextView
                    style="@style/TCTextViewBlack"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/general_amount" />

                <TextView
                    android:id="@+id/frg_transaction_result_tv_amount"
                    style="@style/TCTextViewBlackBold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="1,320.0000 TEE" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fs_10"
                android:orientation="horizontal"
                android:weightSum="3">

                <TextView
                    style="@style/TCTextViewBlack"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/text_total_tec" />

                <TextView
                    android:id="@+id/frg_transaction_result_tv_total_tee_coin"
                    style="@style/TCTextViewBlackBold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="1,320.0000 TEE" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/fs_10"
            android:gravity="center|bottom"
            android:orientation="horizontal"
            android:padding="@dimen/fs_5"
            android:weightSum="2">

            <TextView
                android:id="@+id/activity_main_bottom_cancel_next_button_tv_back_to_home"
                style="@style/TCTextViewGold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_10"
                android:layout_marginEnd="@dimen/fs_10"
                android:layout_weight="1"
                android:background="@drawable/bg_transparent_solid_gold_border_30_curvature"
                android:gravity="center"
                android:paddingStart="@dimen/fs_7"
                android:paddingTop="@dimen/fs_10"
                android:paddingEnd="@dimen/fs_7"
                android:paddingBottom="@dimen/fs_10"
                android:text="@string/send_money_back_to_wallet"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/activity_main_bottom_cancel_next_button_tv_new_send"
                style="@style/TCTextViewWhite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fs_8"
                android:layout_marginEnd="@dimen/fs_10"
                android:layout_weight="1"
                android:background="@drawable/bg_gold_solid_no_border_30_radius"
                android:contentDescription="@string/todo"
                android:gravity="center"
                android:paddingStart="@dimen/fs_20"
                android:paddingTop="@dimen/fs_10"
                android:paddingEnd="@dimen/fs_20"
                android:paddingBottom="@dimen/fs_10"
                android:text="@string/send_money_new_send"
                android:textAllCaps="true"
                android:textColor="@color/c_ffffff" />
        </LinearLayout>
    </LinearLayout>
</android.support.v4.widget.NestedScrollView>
