<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/fs_20">

        <TextView
            style="@style/TCTextViewBlackBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_10"
            android:text="@string/text_name" />

        <LinearLayout
            android:id="@+id/frg_sign_up_account_facebook_v_input_full_name"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fs_38"
            android:layout_marginTop="@dimen/fs_3"
            android:background="@drawable/bg_white_solid_gray_border_5_radius"
            android:orientation="horizontal">

            <ImageView
                style="@style/iv_icon_item_input"
                android:layout_marginStart="@dimen/fs_8"
                android:contentDescription="@string/todo"
                android:src="@drawable/ic_user_name" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/frg_sign_up_account_facebook_et_name"
                    style="@style/TCEditText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/fs_3"
                    android:layout_toStartOf="@+id/frg_sign_up_account_facebook_iv_remove_name"
                    android:background="@android:color/transparent"
                    android:hint="@string/please_enter_your_name"
                    android:maxLines="1"
                    android:textColorHint="@color/c_a6a8b0"
                    tools:ignore="TextFields" />

                <ImageView
                    android:id="@+id/frg_sign_up_account_facebook_iv_remove_name"
                    style="@style/iv_clear_item_input" />

            </RelativeLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/frg_sign_up_account_facebook_tv_error_input_full_name"
            style="@style/tv_b21225_10pt_regular"
            android:text="@string/please_enter_your_name"
            android:visibility="invisible" />

        <TextView
            style="@style/TCTextViewBlackBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_10"
            android:text="@string/text_email" />

        <LinearLayout
            android:id="@+id/frg_sign_up_account_facebook_v_input_email"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fs_38"
            android:layout_marginTop="@dimen/fs_3"
            android:background="@drawable/bg_white_solid_gray_border_5_radius"
            android:orientation="horizontal">

            <ImageView
                style="@style/iv_icon_item_input"
                android:layout_width="@dimen/fs_20"
                android:layout_height="@dimen/fs_18"
                android:layout_marginStart="@dimen/fs_8"
                android:contentDescription="@string/todo"
                android:src="@drawable/ic_email_grey" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/frg_sign_up_account_facebook_et_email"
                    style="@style/TCEditText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/fs_3"
                    android:layout_toStartOf="@+id/frg_sign_up_account_facebook_iv_remove_email"
                    android:background="@android:color/transparent"
                    android:hint="@string/please_enter_your_email"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLength="100"
                    android:maxLines="1"
                    android:textColorHint="@color/c_a6a8b0" />

                <ImageView
                    android:id="@+id/frg_sign_up_account_facebook_iv_remove_email"
                    style="@style/iv_clear_item_input" />

            </RelativeLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/frg_sign_up_account_facebook_tv_error_input_email"
            style="@style/tv_b21225_10pt_regular"
            android:text="@string/please_enter_your_email"
            android:visibility="invisible" />

        <TextView
            style="@style/TCTextViewBlackBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_3"
            android:layout_marginBottom="@dimen/fs_5"
            android:text="@string/phone_number"
            android:textSize="@dimen/ts_12" />

        <TextView
            style="@style/TCTextViewBlack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fs_12"
            android:text="@string/create_new_wallet_message_for_phone_number"
            android:textSize="@dimen/ts_10" />

        <LinearLayout
            android:id="@+id/frg_sign_up_account_facebook_v_input_phone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fs_46"
            android:background="@drawable/bg_white_solid_gray_border_5_radius"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/fs_15"
                android:scaleType="centerInside"
                android:src="@drawable/ic_phone" />

            <Spinner
                android:id="@+id/frg_sign_up_account_facebook_sp_phone_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@null" />

            <ImageView
                android:id="@+id/frg_sign_up_account_facebook_iv_phone_code"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:contentDescription="@string/todo"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_drop_down_black_24dp" />

            <View
                android:layout_width="@dimen/fs_0_5"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/fs_12"
                android:layout_marginBottom="@dimen/fs_12"
                android:background="@color/c_2d2d2d" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.teecoin.ui.AutoResizeEditText
                    android:id="@+id/frg_sign_up_account_facebook_et_input_phone"
                    style="@style/TCTextViewBlack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toStartOf="@+id/frg_sign_up_account_facebook_iv_clear_input_phone"
                    android:background="@null"
                    android:hint="@string/please_enter_your_phone_number"
                    android:imeOptions="actionNext"
                    android:inputType="phone"
                    android:lineSpacingExtra="@dimen/fs_3"
                    android:maxLength="20"
                    android:paddingStart="@dimen/fs_15"
                    android:paddingEnd="@dimen/fs_15"
                    android:textColorHint="@color/c_9b9b9b"
                    android:textSize="@dimen/ts_12"
                    tools:ignore="RtlSymmetry" />

                <ImageView
                    android:id="@+id/frg_sign_up_account_facebook_iv_clear_input_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_delete_text_search"
                    android:visibility="gone" />

            </RelativeLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/frg_sign_up_account_facebook_tv_error_input_phone"
            style="@style/tv_b21225_10pt_regular"
            android:text="@string/please_enter_your_phone_number"
            android:visibility="invisible" />

        <TextView
            style="@style/tv_black_bold_12pt"
            android:text="@string/gender" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/fs_46"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/frg_sign_up_account_facebook_tv_male"
                style="@style/TCTextViewBlack"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_gray_solid_no_border_5_radius"
                android:gravity="center"
                android:text="@string/male"
                android:textSize="@dimen/ts_13" />

            <TextView
                android:id="@+id/frg_sign_up_account_facebook_tv_female"
                style="@style/TCTextViewBlack"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/fs_30"
                android:layout_weight="1"
                android:background="@drawable/bg_gray_solid_no_border_5_radius"
                android:gravity="center"
                android:text="@string/female"
                android:textSize="@dimen/ts_13" />
        </LinearLayout>

        <TextView
            android:id="@+id/frg_sign_up_account_facebook_tv_error_gender"
            style="@style/tv_b21225_10pt_regular"
            android:text="@string/please_choose_gender"
            android:visibility="invisible" />

    </LinearLayout>

</android.support.v4.widget.NestedScrollView>
