<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_toStartOf="@+id/view_item_coupon_user_catalogue_horizontal_list_header_ll_view_all"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingBottom="@dimen/fs_10"
    tools:ignore="RtlSymmetry">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/fs_20"
            android:layout_height="@dimen/fs_22"
            android:layout_gravity="center_vertical"
            android:contentDescription="@string/todo"
            android:src="@drawable/ic_coupon_gold" />

        <TextView
            android:id="@+id/frag_user_coupon_catalogue_result_tv_name"
            style="@style/TCTextViewGoldBoldLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/fs_10"
            android:layout_marginStart="@dimen/fs_10"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/text_coupon_for_free" />
    </LinearLayout>

    <TextView
        android:id="@+id/frag_user_coupon_catalogue_result_tv_notification"
        style="@style/TCTextViewBlack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/coupon_check_in_delivered_via_notification"
        android:visibility="gone" />
</LinearLayout>
