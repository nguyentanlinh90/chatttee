<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/frg_transaction_success"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/fs_130">

        <com.teecoin.utils.RippleBackground
            android:layout_width="@dimen/fs_130"
            android:layout_height="@dimen/fs_130"
            android:layout_centerInParent="true"
            android:gravity="center"
            app:rb_color="#b1993f"
            app:rb_duration="10000"
            app:rb_radius="32dp"
            app:rb_rippleAmount="3"
            app:rb_scale="2"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/frg_transaction_iv_succes"
                android:layout_width="@dimen/fs_100"
                android:layout_height="@dimen/fs_100"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_success" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
