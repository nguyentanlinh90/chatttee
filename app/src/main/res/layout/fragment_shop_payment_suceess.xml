<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout style="@style/LinearLayoutVerticalParent">

        <ImageView
            android:id="@+id/frg_transaction_iv_succes"
            android:layout_width="@dimen/fs_100"
            android:layout_height="@dimen/fs_100"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/fs_50"
            android:contentDescription="@string/todo"
            android:src="@drawable/ic_check_success" />

        <TextView
            style="@style/TCTextViewGoldBoldLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_20"
            android:gravity="center"
            android:text="@string/coupon_successful" />

        <LinearLayout
            style="@style/view_group_discover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_20"
            android:orientation="vertical"
            android:paddingStart="@dimen/fs_0">

            <LinearLayout
                style="@style/LinearLayoutHorizontalFullWidth"
                android:layout_margin="@dimen/fs_15">

                <TextView
                    style="@style/TCTextViewBlack"
                    android:text="@string/customer" />

                <TextView
                    android:id="@+id/frag_shop_payment_success_tv_customer"
                    style="@style/TCTextViewBlackBold"
                    android:layout_width="match_parent"
                    android:layout_marginStart="@dimen/fs_15"
                    android:ellipsize="end"
                    android:gravity="right"
                    android:maxLines="1"
                    android:text="@string/customer"
                    android:textSize="@dimen/fs_13"
                    tools:ignore="RtlHardcoded,SpUsage" />

            </LinearLayout>

            <include layout="@layout/view_line" />

            <LinearLayout
                style="@style/LinearLayoutHorizontalFullWidth"
                android:layout_marginEnd="@dimen/fs_15"
                android:layout_marginStart="@dimen/fs_15"
                android:layout_marginTop="@dimen/fs_15">

                <TextView
                    style="@style/TCTextViewBlack"
                    android:text="@string/total_bill" />

                <TextView
                    android:id="@+id/frag_shop_payment_success_tv_total_bill"
                    style="@style/TCTextViewBlackBold"
                    android:layout_width="match_parent"
                    android:layout_marginStart="@dimen/fs_15"
                    android:gravity="right"
                    android:text="@string/text_zero"
                    android:textSize="@dimen/fs_13"
                    tools:ignore="RtlHardcoded,SpUsage" />

            </LinearLayout>

            <LinearLayout
                style="@style/LinearLayoutHorizontalFullWidth"
                android:layout_margin="@dimen/fs_15">

                <TextView
                    style="@style/TCTextViewBlack"
                    android:text="@string/amount_to_be_by_wallet" />

                <TextView
                    android:id="@+id/frag_shop_payment_success_tv_amount_wallet"
                    style="@style/TCTextViewBlackBold"
                    android:layout_width="match_parent"
                    android:layout_marginStart="@dimen/fs_15"
                    android:gravity="right"
                    android:text="@string/text_zero"
                    android:textSize="@dimen/fs_13"
                    tools:ignore="RtlHardcoded,SpUsage" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/frag_shop_payment_success_ll_coinback"
                style="@style/LinearLayoutHorizontalFullWidth"
                android:layout_marginBottom="@dimen/fs_15"
                android:layout_marginEnd="@dimen/fs_15"
                android:layout_marginStart="@dimen/fs_15"
                android:visibility="visible">

                <TextView
                    style="@style/TCTextViewBlack"
                    android:text="@string/text_coin_back" />

                <TextView
                    android:id="@+id/frag_shop_payment_success_tv_coinback"
                    style="@style/TCTextViewBlackBold"
                    android:layout_width="match_parent"
                    android:layout_marginStart="@dimen/fs_15"
                    android:gravity="right"
                    android:text="@string/text_zero"
                    android:textSize="@dimen/fs_13"
                    tools:ignore="RtlHardcoded,SpUsage" />

            </LinearLayout>

            <include
                layout="@layout/view_line"
                android:layout_width="match_parent"
                android:layout_height="0.3dp" />

            <LinearLayout
                style="@style/LinearLayoutHorizontalFullWidth"
                android:layout_margin="@dimen/fs_15">

                <TextView
                    style="@style/TCTextViewBlack"
                    android:text="@string/amount_to_be_by_cash" />

                <TextView
                    android:id="@+id/frag_shop_payment_success_tv_amount_cash"
                    style="@style/TCTextViewBlackBold"
                    android:layout_width="match_parent"
                    android:layout_marginStart="@dimen/fs_15"
                    android:gravity="right"
                    android:text="@string/text_zero"
                    android:textSize="@dimen/fs_13"
                    tools:ignore="RtlHardcoded,SpUsage" />

            </LinearLayout>

            <LinearLayout
                style="@style/LinearLayoutHorizontalFullWidth"
                android:layout_gravity="center_vertical"
                android:layout_marginBottom="@dimen/fs_10"
                android:layout_marginEnd="@dimen/fs_15"
                android:layout_marginStart="@dimen/fs_5"
                android:layout_marginTop="@dimen/fs_10"
                android:gravity="center_vertical"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/fs_25"
                    android:layout_height="@dimen/fs_25"
                    android:contentDescription="@string/todo"
                    android:src="@drawable/ic_notification_gold" />

                <TextView
                    style="@style/TCTextViewGray"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fs_7"
                    android:text="@string/please_collect_the_remaining_cash_payment" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/frag_shop_payment_success_tv_new_payment"
            style="@style/TCTextViewWhite"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fs_39"
            android:layout_marginBottom="@dimen/fs_25"
            android:layout_marginEnd="@dimen/fs_50"
            android:layout_marginStart="@dimen/fs_50"
            android:layout_marginTop="@dimen/fs_20"
            android:background="@drawable/bg_gold_solid_no_border_30_radius"
            android:gravity="center"
            android:text="@string/transaction_success_new_payment"
            android:textAllCaps="true" />
    </LinearLayout>

</android.support.v4.widget.NestedScrollView>
