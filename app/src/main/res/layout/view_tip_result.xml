<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:paddingBottom="@dimen/fs_15">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:ignore="UselessParent">
    <TextView
        style="@style/TCTextViewGoldBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fs_20"
        android:layout_marginBottom="@dimen/fs_20"
        android:gravity="center"
        android:text="@string/dialog_tip_title" />
    <include layout="@layout/view_line"
        />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/fs_20"
        android:src="@drawable/ic_check_success"
        android:contentDescription="@string/todo" />

    <TextView
        style="@style/TCTextViewBlackBoldLarge"
        android:layout_width="match_parent"
        android:gravity="center"
        android:layout_marginTop="@dimen/fs_20"
        android:layout_height="wrap_content"
        android:text="@string/thank_for_your_tip" />

    <TextView
        android:id="@+id/view_tip_result_tv_transaction_id"
        style="@style/TCTextViewBlack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fs_10"
        android:gravity="center"
        android:paddingEnd="@dimen/fs_5"
        android:paddingStart="@dimen/fs_5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fs_10"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            style="@style/TCTextViewBlackBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_total_tec" />

        <TextView
            android:id="@+id/view_tip_result_tv_total_amount"
            style="@style/TCTextViewBlackBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fs_10"
            android:text="@string/text_value_double" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/fs_10"
        android:layout_marginTop="@dimen/fs_20"
        android:gravity="center">

        <TextView
            android:id="@+id/view_tip_result_tv_close"
            style="@style/TCTextViewWhite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gold_solid_no_border_30_radius"
            android:paddingBottom="@dimen/fs_8"
            android:paddingLeft="@dimen/fs_50"
            android:paddingRight="@dimen/fs_50"
            android:paddingTop="@dimen/fs_8"
            android:text="@string/text_ok" />
    </LinearLayout>

    </LinearLayout>
</RelativeLayout>
