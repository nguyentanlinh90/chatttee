<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/view_header_vendor_info"
    android:layout_width="match_parent"
    android:layout_height="@dimen/fs_280"
    android:clickable="true"
    android:focusable="true">

    <android.support.design.widget.CollapsingToolbarLayout
        android:id="@+id/collapsing_toolbar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:collapsedTitleTextAppearance="@style/CollapsedTitle"
        app:expandedTitleMarginBottom="@dimen/fs_36"
        app:expandedTitleMarginEnd="0dp"
        app:expandedTitleMarginStart="@dimen/fs_10"
        android:background="@android:color/white"
        app:expandedTitleTextAppearance="@style/ExpandedTitle"
        app:layout_scrollFlags="scroll|exitUntilCollapsed"
        app:title="">

        <com.teecoin.ui.TCViewPager
            android:id="@+id/frag_vendor_detail_vp_image"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fs_200"
            android:background="@color/c_f2f2f2"
            android:contentDescription="@string/todo"
            android:fitsSystemWindows="true"
            android:scaleType="centerCrop"
            app:layout_collapseMode="parallax"
            app:layout_collapseParallaxMultiplier="0.6"
            app:layout_scrollFlags="scroll" />
        <!--background-->
        <!-- android:background="@color/c_75000000"-->

        <android.support.v7.widget.Toolbar
            android:id="@+id/frg_coupon_user_my_coupon_detail_toolbar"
            android:layout_width="?android:attr/actionBarSize"
            android:layout_height="?android:attr/actionBarSize"
            android:layout_marginBottom="@dimen/fs_45"
            android:layout_marginStart="-5dp"
            app:contentInsetStartWithNavigation="-25dp"
            app:layout_collapseMode="pin"
            app:navigationIcon="@drawable/ic_back_white_black_shadow"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />
        <!--android:layout_marginBottom="@dimen/fs_45"-->

        <RelativeLayout
            android:id="@+id/frag_vendor_rl_rating_write_review_for_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="bottom"
            app:contentInsetStartWithNavigation="0dp">

            <LinearLayout
                android:id="@+id/frag_vendor_ll_share_write_review_vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_above="@+id/ll_name_vendor"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/fs_15"
                android:orientation="vertical"
                android:weightSum="3"
                tools:ignore="UselessParent">

                <LinearLayout
                    android:id="@+id/frag_vendor_ll_write_review_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/frag_vendor_iv_write_review_vertical"
                        android:layout_width="@dimen/fs_43"
                        android:layout_height="@dimen/fs_43"
                        android:contentDescription="@string/todo"
                        android:padding="@dimen/fs_2"
                        android:src="@drawable/ic_pen_bg_circle_white" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/frag_vendor_ll_write_share_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/frag_vendor_iv_share_vertical"
                        android:layout_width="@dimen/fs_43"
                        android:layout_height="@dimen/fs_43"
                        android:contentDescription="@string/todo"
                        android:padding="@dimen/fs_2"
                        android:src="@drawable/ic_share_bg_circle_white" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/frag_vendor_ll_write_favorite_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/frag_vendor_iv_favorite_vertical"
                        android:layout_width="@dimen/fs_39"
                        android:layout_height="@dimen/fs_39"
                        android:background="@drawable/state_favorite"
                        android:contentDescription="@string/todo"
                        android:padding="@dimen/fs_2" />
                </LinearLayout>
            </LinearLayout>

            <!---->
            <ru.tinkoff.scrollingpagerindicator.ScrollingPagerIndicator
                android:id="@+id/frag_vendor_review_pager_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/ll_name_vendor"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="@dimen/fs_6"
                app:spi_dotColor="@color/c_e0e0e0"
                app:spi_dotSelectedColor="@color/c_baa35c"
                app:spi_dotSelectedSize="@dimen/fs_8"
                app:spi_dotSize="@dimen/fs_5"
                app:spi_looped="false"
                app:spi_visibleDotThreshold="1" />
            <!-- app:spi_visibleDotCount="10"-->
            <!--<com.bikomobile.circleindicatorpager.CircleIndicatorPager-->
            <!--android:id="@+id/frag_vendor_review_circle_page"-->
            <!--android:layout_width="wrap_content"-->
            <!--android:layout_height="wrap_content"-->
            <!--android:layout_above="@+id/ll_name_vendor"-->
            <!--android:layout_centerHorizontal="true"-->
            <!--android:layout_marginBottom="@dimen/fs_5"-->
            <!--app:ci_drawable="@drawable/bg_dot_white_full"-->
            <!--app:ci_drawable_unselected="@drawable/bg_dot_border"-->
            <!--app:ci_height="7dp"-->
            <!--app:ci_width="7dp"-->
            <!--app:layout_collapseMode="parallax"-->
            <!--app:layout_collapseParallaxMultiplier="0.6"-->
            <!--/>-->

            <LinearLayout
                android:id="@+id/ll_name_vendor"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fs_80"
                android:layout_alignParentBottom="true"
                android:background="@android:color/white"
                android:orientation="vertical"
                android:paddingStart="@dimen/fs_15"
                tools:ignore="RtlSymmetry">

                <TextView
                    android:id="@+id/vendor_detail_tv_name_vendor"
                    style="@style/TCTextViewBlackBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingTop="@dimen/fs_10"
                    android:text="@string/text_three_dot"
                    android:textSize="@dimen/ts_18" />

                <LinearLayout
                    style="@style/LinearLayoutHorizontalFullWidth"
                    android:layout_marginTop="@dimen/fs_5"
                    android:paddingBottom="@dimen/fs_10"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/vendor_detail_tv_rating"
                        style="@style/TCTextViewBlack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_three_dot"
                        android:textSize="@dimen/ts_14" />

                    <me.zhanghai.android.materialratingbar.MaterialRatingBar
                        android:id="@+id/vendor_detail_rating_bar"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/fs_13"
                        android:layout_marginStart="@dimen/fs_5"
                        android:isIndicator="true"
                        android:rating="0"
                        android:stepSize="0.1" />


                    <TextView
                        android:id="@+id/vendor_detail_tv_review"
                        style="@style/TCTextViewBlack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/fs_5"
                        android:text="@string/text_three_dot"
                        android:textSize="@dimen/ts_14" />

                    <ImageView
                        android:id="@+id/vendor_detail_iv_is_coupon"
                        android:layout_width="@dimen/fs_30"
                        android:layout_height="@dimen/fs_25"
                        android:layout_marginStart="@dimen/fs_10"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/ic_coupon_category" />

                    <ImageView
                        android:id="@+id/vendor_detail_iv_is_cash"
                        android:layout_width="@dimen/fs_40"
                        android:layout_height="@dimen/fs_20"
                        android:layout_marginStart="@dimen/fs_10"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/ic_cash_voucher"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/frag_vendor_ll_share_write_review_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_gravity="right"
                android:layout_marginEnd="@dimen/fs_18"
                android:paddingBottom="@dimen/fs_5"
                android:gravity="right"
                android:orientation="horizontal"
                tools:ignore="RtlHardcoded">

                <ImageView
                    android:id="@+id/frag_vendor_iv_write_review_horizontal"
                    android:layout_width="@dimen/fs_25"
                    android:layout_height="@dimen/fs_25"
                    android:contentDescription="@string/todo"
                    android:padding="@dimen/fs_2"
                    android:src="@drawable/ic_pen_bg_circle_white" />

                <ImageView
                    android:id="@+id/frag_vendor_iv_share_horizontal"
                    android:layout_width="@dimen/fs_25"
                    android:layout_height="@dimen/fs_25"
                    android:layout_marginEnd="@dimen/fs_10"
                    android:layout_marginStart="@dimen/fs_10"
                    android:contentDescription="@string/todo"
                    android:padding="@dimen/fs_2"
                    android:src="@drawable/ic_share_bg_circle_white" />

                <ImageView
                    android:id="@+id/frag_vendor_iv_favorite_horizontal"
                    android:layout_width="@dimen/fs_21"
                    android:layout_height="@dimen/fs_21"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="@dimen/fs_0_5"
                    android:background="@drawable/state_favorite"
                    android:contentDescription="@string/todo" />

            </LinearLayout>
        </RelativeLayout>
    </android.support.design.widget.CollapsingToolbarLayout>
</android.support.design.widget.AppBarLayout>
