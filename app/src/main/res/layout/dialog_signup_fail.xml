<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dialog_signup_fail_v_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginEnd="@dimen/fs_25"
        android:layout_marginStart="@dimen/fs_25"
        android:background="@drawable/bg_white_solid_no_border_5_radius"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="@dimen/fs_21">

        <ImageView
            android:id="@+id/dialog_signup_fail_iv_icon"
            android:layout_width="@dimen/fs_70"
            android:layout_height="@dimen/fs_70"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/todo"
            android:src="@drawable/ic_fail" />

        <TextView
            android:id="@+id/dialog_signup_fail_tv_title"
            style="@style/TCTextViewGrayBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fs_31"
            android:layout_marginTop="@dimen/fs_10"
            android:gravity="center_horizontal"
            android:textAllCaps="true"
            android:text="@string/text_three_dot"
            android:textSize="@dimen/ts_16" />

        <TextView
            android:id="@+id/dialog_signup_fail_tv_message"
            style="@style/TCTextViewBlack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fs_20"
            android:gravity="center_horizontal"
            android:lineSpacingExtra="@dimen/fs_5"
            android:textSize="@dimen/ts_12" />

        <TextView
            android:id="@+id/dialog_signup_fail_tv_login_by"
            style="@style/TCTextViewWhiteBold"
            android:layout_width="@dimen/fs_210"
            android:layout_height="@dimen/fs_39"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/fs_66"
            android:background="@drawable/bg_gold_solid_no_border_30_radius"
            android:gravity="center"
            android:text="@string/login_by_facebook"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/dialog_signup_fail_tv_restart"
            style="@style/TCTextViewGold"
            android:layout_width="@dimen/fs_210"
            android:layout_height="@dimen/fs_39"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/fs_10"
            android:background="@drawable/bg_white_solid_gold_border_30_radius"
            android:gravity="center"
            android:text="@string/restart_again"
            android:textAllCaps="true" />

        <TextView
            style="@style/TCTextViewBlack"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/fs_5"
            android:gravity="center"
            android:text="@string/go_to_home_for_other_signup"
            android:textSize="@dimen/fs_9"
            tools:ignore="SpUsage" />
    </LinearLayout>
</RelativeLayout>
