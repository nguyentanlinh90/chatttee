<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/fs_56">

        <ImageView
            android:id="@+id/frg_scan_iv_back_toolbar"
            android:layout_width="@dimen/fs_56"
            android:layout_height="@dimen/fs_56"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back_white_24pt"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/frag_scan_tv_title_header"
            style="@style/TCTextViewWhite"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:text="header"
            android:textAllCaps="true"
            android:textSize="@dimen/ts_17"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/frag_scan_tv_input"
            style="@style/TCTextViewWhite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/fs_8"
            android:background="@drawable/bg_gold_solid_no_border_30_radius"
            android:gravity="center"
            android:paddingBottom="@dimen/fs_4"
            android:paddingEnd="@dimen/fs_30"
            android:paddingStart="@dimen/fs_30"
            android:paddingTop="@dimen/fs_2"
            android:text="@string/input"
            android:textSize="@dimen/ts_14" />
    </RelativeLayout>

    <TextView
        style="@style/TCTextViewWhite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginEnd="@dimen/fs_25"
        android:layout_marginStart="@dimen/fs_25"
        android:gravity="center_horizontal"
        android:text="@string/scan_the_qr_code_displayed_at_the_merchant_outlet"
        android:visibility="gone"
        android:textSize="@dimen/ts_14" />
</LinearLayout>