<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    >

    <ImageView
        android:id="@+id/iv_event"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fs_180"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:scaleType="fitXY"
        android:contentDescription="@string/todo"
        android:src="@drawable/ic_logo_chattee" />
    <TextView
        android:id="@+id/tv_description"
        style="@style/TCTextViewBlack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="7"
        android:layout_marginTop="@dimen/fs_10"
        android:text="@string/text_text"
        android:paddingBottom="@dimen/fs_3"
        android:layout_marginStart="@dimen/fs_10"
        android:layout_marginEnd="@dimen/fs_10"
        />
</LinearLayout>